---
---

<div class="loader" id="loader">
  <div class="loader-panel">
    <div class="loader-titlebar">
      <span class="loader-dot"></span>
      <span class="loader-titlebar-text">boot.sh</span>
    </div>
    <pre class="loader-log" id="loaderLog" aria-hidden="true"></pre>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    background: var(--bg);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .loader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader-panel {
    width: 100%;
    max-width: 480px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .loader-titlebar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
  }

  .loader-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent-glow-strong);
    animation: loader-pulse 1.1s ease-in-out infinite;
  }

  .loader-titlebar-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .loader-log {
    margin: 0;
    padding: 1.1rem 1.1rem 1.3rem;
    min-height: 9.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.65;
    color: var(--muted);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .loader-log :global(.ok) { color: var(--success); }
  .loader-log :global(.warn) { color: var(--warning); }
  .loader-log :global(.accent) { color: var(--accent); }
  .loader-log :global(.cursor) {
    display: inline-block;
    width: 0.55em;
    background: var(--accent);
    animation: loader-blink 1s step-end infinite;
  }

  @keyframes loader-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @keyframes loader-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader { display: none; }
  }
</style>

<script>
  const loader = document.getElementById('loader');
  const logEl = document.getElementById('loaderLog');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (loader) {
    if (prefersReducedMotion || !logEl) {
      loader.classList.add('hidden');
      document.body.style.overflow = 'auto';
    } else {
      document.body.style.overflow = 'hidden';

      const pad = (n: number) => n.toString().padStart(2, '0');
      const now = new Date();
      const t = (offsetMs: number) => {
        const d = new Date(now.getTime() + offsetMs);
        return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${d.getMilliseconds().toString().padStart(3, '0')}`;
      };

      const lines: { text: string; cls?: string; delay: number }[] = [
        { text: `[ ${t(0)} ] init dsltdev.com — entorno estático`, delay: 0 },
        { text: `[ ${t(60)} ] montando /proyectos ... `, cls: 'ok', delay: 90 },
        { text: `[ ${t(140)} ] verificando integraciones: Wompi, Bancolombia, Truora ... `, cls: 'ok', delay: 170 },
        { text: `[ ${t(230)} ] cargando Cloudflare Workers ... `, cls: 'ok', delay: 240 },
        { text: `[ ${t(310)} ] listo.`, cls: 'accent', delay: 300 },
      ];

      let cursor = document.createElement('span');
      cursor.className = 'cursor';
      cursor.textContent = ' ';

      let acc = 0;
      lines.forEach((line, i) => {
        acc += line.delay;
        setTimeout(() => {
          if (!logEl) return;
          const row = document.createElement('div');
          if (line.cls) {
            const label = line.text;
            row.innerHTML = label.replace(/\.\.\. $/, `... <span class="${line.cls}">OK</span>`);
          } else {
            row.textContent = line.text;
          }
          logEl.appendChild(row);
          if (i === lines.length - 1) {
            row.appendChild(cursor);
          }
        }, acc);
      });

      const totalDelay = acc + 500;
      setTimeout(() => {
        loader?.classList.add('hidden');
        document.body.style.overflow = 'auto';
      }, totalDelay);
    }
  }
</script>
