---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-glow"></div>
  <div class="container">
    <div class="footer-content">
      <div class="footer-left">
        <span class="footer-logo">
          <span class="footer-logo-icon">[</span>DL<span class="footer-logo-icon">]</span>
        </span>
        <p class="footer-copy">&copy; {currentYear} David López · build estático</p>
      </div>

      <div class="footer-right">
        <a href="#projects">Proyectos</a>
        <a href="/terms">Términos</a>
        <a href="/privacy">Privacidad</a>
        <a href="https://github.com/dsltdev" target="_blank">GitHub</a>
        <a href="mailto:dsltdev@icloud.com">Email</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 5%;
    background: var(--surface);
    border-top: 2px solid var(--border);
    color: var(--text);
    position: relative;
    z-index: 1;
  }

  .footer-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), var(--secondary), transparent);
    opacity: 0.6;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-logo-icon {
    background: linear-gradient(135deg, var(--accent), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-copy {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer-right {
    display: flex;
    gap: 2rem;
  }

  .footer-right a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-light);
    transition: all 0.3s ease;
    position: relative;
    padding-bottom: 4px;
  }

  .footer-right a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--secondary));
    transition: width 0.3s var(--ease-out);
  }

  .footer-right a:hover {
    color: var(--accent);
  }

  .footer-right a:hover::after {
    width: 100%;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }

    .footer-left {
      flex-direction: column;
      gap: 0.5rem;
    }

    .footer-right {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .footer {
      background: var(--bg);
    }
  }
</style>
