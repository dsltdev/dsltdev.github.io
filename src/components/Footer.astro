---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-glow"></div>
  <div class="container">
    <div class="footer-content">
      <div class="footer-left">
        <span class="footer-logo">
          <span class="footer-logo-icon">▸</span>DL
        </span>
        <p class="footer-copy">&copy; {currentYear} David López</p>
      </div>

      <div class="footer-right">
        <a href="/app">Generador</a>
        <a href="/pricing">Precios</a>
        <a href="/blog">Blog</a>
        <a href="/terms">Términos</a>
        <a href="/privacy">Privacidad</a>
        <a href="https://github.com/dsltdev" target="_blank">GitHub</a>
        <a href="mailto:dsltdev@icloud.com">Email</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 5%;
    background: rgba(5, 10, 8, 0.8);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid rgba(0, 230, 138, 0.06);
    color: var(--text);
    position: relative;
    z-index: 1;
  }

  .footer-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.4;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-logo-icon {
    color: var(--accent);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .footer-right {
    display: flex;
    gap: 2rem;
  }

  .footer-right a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    transition: all 0.3s ease;
    position: relative;
  }

  .footer-right a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease-out);
  }

  .footer-right a:hover {
    color: var(--accent);
  }

  .footer-right a:hover::after {
    width: 100%;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }

    .footer-left {
      flex-direction: column;
      gap: 0.5rem;
    }

    .footer-right {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .footer {
      background: rgba(5, 10, 8, 0.98);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
