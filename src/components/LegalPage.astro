---
import Sitio from '../layouts/Sitio.astro';
import { PLATAFORMA } from '../data/plataforma';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Sitio title={`${title} — ${PLATAFORMA.nombre}`} description={description}>
  <header class="cab">
    <div class="contenedor cab-in">
      <a class="marca" href="/"><span class="marca-punto" aria-hidden="true"></span>{PLATAFORMA.nombre}</a>
      <div class="cab-acciones">
        <a class="btn btn-ghost" href="/">← Inicio</a>
      </div>
    </div>
  </header>

  <main class="legal">
    <h1>{title}</h1>
    <p class="legal-fecha">Última actualización: {updated}</p>
    <div class="legal-cuerpo">
      <slot />
    </div>
  </main>

  <footer class="pie">
    <div class="contenedor pie-in">
      <span>© {new Date().getFullYear()} {PLATAFORMA.nombre}</span>
      <nav aria-label="Pie de página">
        <a href="/privacy">Privacidad</a>
        <a href="/terms">Términos</a>
        <a href={`mailto:${PLATAFORMA.email}`}>Contacto</a>
      </nav>
    </div>
  </footer>
</Sitio>

<style>
  .legal {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px clamp(16px, 4vw, 32px) 72px;
  }
  h1 {
    font-size: clamp(28px, 4.5vw, 40px);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 8px;
  }
  .legal-fecha {
    color: var(--suave);
    font-size: 14px;
    margin: 0 0 32px;
  }
  .legal-cuerpo :global(h2) {
    font-size: 22px;
    letter-spacing: -0.02em;
    margin: 44px 0 6px;
    padding-top: 24px;
    border-top: 1px solid var(--borde);
    scroll-margin-top: 80px;
  }
  .legal-cuerpo :global(h3) {
    font-size: 17px;
    margin: 28px 0 4px;
  }
  .legal-cuerpo :global(p),
  .legal-cuerpo :global(li) {
    line-height: 1.7;
    margin: 8px 0;
  }
  .legal-cuerpo :global(ul) {
    padding-left: 22px;
  }
  .legal-cuerpo :global(code) {
    background: var(--superficie-2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
