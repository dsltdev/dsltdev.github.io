---
const skills = [
  {
    id: "firma",
    name: "Firma de webhook",
    code: "01",
    lie: "Un POST 200 y un mock de pasarela. expect(ok). Nadie verifica la firma en el test.",
    edge: "Wompi firma con un secreto, pero Payouts usa otro. Bancolombia manda el timestamp fuera del payload firmado. Un atacante puede forjar webhooks válidos.",
    probe: "Enviar webhook con firma incorrecta. Debe rechazarse con 401. Verificar que cada producto (checkout, payouts) use su secreto correcto.",
    lives: "Wompi Payouts · Bancolombia",
  },
  {
    id: "idempotencia",
    name: "Idempotencia",
    code: "02",
    lie: "Un ID único en la DB. El test nunca reintenta la misma transacción.",
    edge: "Reintento de red duplica el cargo. Cliente ve doble cobro. O peor: un reintento de reversión borra dos transacciones.",
    probe: "Enviar el mismo webhook dos veces con el mismo ID. Solo debe procesarse una vez. Verificar que el balance final sea correcto.",
    lives: "Cybersentinel · wallet",
  },
  {
    id: "race",
    name: "Race conditions",
    code: "03",
    lie: "La suite serial. Un fill, un ciclo, cero solapes. Los tests nunca ejecutan dos requests simultáneos.",
    edge: "Dos órdenes al mismo tiempo leen el mismo balance, ambas pasan la validación, ambas debitan. El libro de cuentas queda negativo.",
    probe: "Disparar dos transacciones concurrentes que compiten por el mismo recurso. Solo una debe procesar, la otra debe fallar con lock o insufficient funds.",
    lives: "Paper-exec · consumer",
  },
  {
    id: "montos",
    name: "Montos y decimales",
    code: "04",
    lie: "parseInt(amount) y listo. El test usa 100, 200. Nadie prueba con decimales, COP sin centavos, o fees fraccionarios.",
    edge: "COP no tiene subunidades pero el API recibe centavos. Fee de 2.9% genera fracciones. Conversión USD/COP pierde precisión. Cliente ve $100.000 cobrado como $10.000.000.",
    probe: "Transacción de $1 COP, fee de 2.9%. Verificar redondeo. Conversión USD↔COP. Verificar que los decimales no se pierdan ni multipliquen.",
    lives: "Wallet · desk paper",
  },
  {
    id: "integraciones",
    name: "Contratos API reales",
    code: "05",
    lie: "MSW / nock y un JSON de fixtures. Docs en verde, prod en 403. El mock nunca se actualiza cuando la API cambia.",
    edge: "Políticas de identidad, rate limit, payload que cambió sin aviso. El contrato real no es el README. La API de staging se comporta distinto a prod.",
    probe: "Llamada viva con timeout. Si la política niega, no inventar el UUID. Verificar errores reales: 401, 429, 500.",
    lives: "APIs ajenas · WhatsApp · Truora",
  },
  {
    id: "conciliacion",
    name: "Conciliación",
    code: "06",
    lie: "Balance = sum(transactions). El test nunca verifica que el balance del proveedor coincida con el interno.",
    edge: "Webhook perdido, orden duplicada en el provider pero no en tu DB, discrepancia silenciosa que crece con el tiempo.",
    probe: "Comparar balance interno contra reporte del proveedor (Wompi, Bancolombia). Debe coincidir. Si no, tener proceso de reconciliación manual.",
    lives: "Cybersentinel · wallets",
  },
];
---

<div class="skill-board glass-card">
  {skills.map((s, i) => (
    <input
      class="skill-radio"
      type="radio"
      name="hard-skill"
      id={`sk-${s.id}`}
      checked={i === 0}
    />
  ))}

  <div class="skill-board-head">
    <span class="skill-board-kicker">Riesgos en sistemas de pago</span>
    <p>
      Las integraciones de pago fallan en formas específicas. Estas son las categorías de riesgo que reviso
      en cada auditoría, con ejemplos de cómo se prueban correctamente.
    </p>
  </div>

  <div class="skill-body">
    <div class="skill-rail" role="presentation">
      {skills.map((s) => (
        <label class={`skill-tab skill-tab-${s.id}`} for={`sk-${s.id}`}>
          <span class="skill-tab-code">{s.code}</span>
          {s.name}
        </label>
      ))}
    </div>

    <div class="skill-stage">
      {skills.map((s) => (
        <article class={`skill-panel skill-panel-${s.id}`} data-panel={s.id}>
          <header class="skill-panel-head">
            <h3>{s.name}</h3>
            <span>{s.lives}</span>
          </header>
          <div class="skill-cols">
            <div>
              <h4>Qué falla en los tests</h4>
              <p>{s.lie}</p>
            </div>
            <div>
              <h4>Qué pasa en producción</h4>
              <p>{s.edge}</p>
            </div>
            <div>
              <h4>Cómo lo reviso</h4>
              <p>{s.probe}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="skill-board-foot">
    <span>Piezas que sí se pueden nombrar:</span>
    <span>Cybersentinel</span>
    <span aria-hidden="true">·</span>
    <span>Desk paper Binance / BVC</span>
    <span aria-hidden="true">·</span>
    <span>Bellas Cocinas</span>
  </div>
</div>

<style>
  .skill-board {
    position: relative;
    padding: 1.25rem 1.3rem 1.05rem;
    display: grid;
    gap: 1.05rem;
  }

  .skill-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skill-board-head {
    display: grid;
    gap: 0.4rem;
  }

  .skill-board-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .skill-board-head p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 46rem;
  }

  .skill-body {
    display: grid;
    grid-template-columns: 11.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .skill-rail {
    display: grid;
    gap: 0.35rem;
  }

  .skill-tab {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--muted);
    background: transparent;
  }

  .skill-tab:hover {
    color: var(--text);
    background: var(--glass-bg);
  }

  .skill-tab-code {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    opacity: 0.55;
  }

  .skill-stage {
    min-height: 16rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.15rem 1.2rem 1.2rem;
  }

  .skill-panel {
    display: none;
    gap: 1rem;
  }

  .skill-panel-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    align-items: baseline;
  }

  .skill-panel-head h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
  }

  .skill-panel-head span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .skill-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }

  .skill-cols h4 {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .skill-cols p {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .skill-board-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .skill-board-foot a {
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .skill-board-foot a:hover {
    text-decoration: underline;
  }

  #sk-firma:checked ~ .skill-body .skill-tab-firma,
  #sk-idempotencia:checked ~ .skill-body .skill-tab-idempotencia,
  #sk-race:checked ~ .skill-body .skill-tab-race,
  #sk-montos:checked ~ .skill-body .skill-tab-montos,
  #sk-integraciones:checked ~ .skill-body .skill-tab-integraciones,
  #sk-conciliacion:checked ~ .skill-body .skill-tab-conciliacion {
    color: var(--text);
    border-color: var(--accent-dim);
    background: var(--glass-bg-hover);
  }

  #sk-firma:checked ~ .skill-body .skill-panel-firma,
  #sk-idempotencia:checked ~ .skill-body .skill-panel-idempotencia,
  #sk-race:checked ~ .skill-body .skill-panel-race,
  #sk-montos:checked ~ .skill-body .skill-panel-montos,
  #sk-integraciones:checked ~ .skill-body .skill-panel-integraciones,
  #sk-conciliacion:checked ~ .skill-body .skill-panel-conciliacion {
    display: grid;
  }

  #sk-firma:focus-visible ~ .skill-body .skill-tab-firma,
  #sk-idempotencia:focus-visible ~ .skill-body .skill-tab-idempotencia,
  #sk-race:focus-visible ~ .skill-body .skill-tab-race,
  #sk-montos:focus-visible ~ .skill-body .skill-tab-montos,
  #sk-integraciones:focus-visible ~ .skill-body .skill-tab-integraciones,
  #sk-conciliacion:focus-visible ~ .skill-body .skill-tab-conciliacion {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .skill-body {
      grid-template-columns: 1fr;
    }

    .skill-rail {
      grid-template-columns: repeat(3, 1fr);
    }

    .skill-cols {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .skill-rail {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
