---

<section id="about" class="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-left">
        <p class="section-label">// 001</p>
        <h2 class="section-title">Sobre mí</h2>
      </div>

      <div class="about-right">
        <div class="about-content">
          <p class="about-text-large">
            Desarrollador Full Stack con 5+ años de experiencia.
            Me enfoco en crear productos digitales que funcionan.
          </p>
          
          <p class="about-text">
            Trabajo con startups y empresas para construir software que importa.
            Código limpio, arquitectura sólida, resultados reales.
          </p>

          <p class="about-text">
            Cuando no estoy programando, estoy leyendo sobre tecnología
            o contribuyendo a proyectos open source.
          </p>
        </div>

        <div class="about-details">
          <div class="detail-item">
            <span class="detail-label">Ubicación</span>
            <span class="detail-value">Medellín, Colombia</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Disponibilidad</span>
            <span class="detail-value available">● Abierto a proyectos</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Especialidad</span>
            <span class="detail-value">Full Stack / Web Apps</span>
          </div>
        </div>

        <div class="about-cta">
          <a href="#contact" class="btn btn-primary">Hablemos →</a>
          <a href="#" class="btn btn-secondary">CV ↓</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .about-text-large {
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.95);
  }

  .about-text {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
  }

  .about-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    margin-bottom: 2rem;
    transition: all 0.3s ease;
  }

  .about-details:hover {
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    transform: translateY(-4px);
  }

  .detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .detail-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.6);
  }

  .detail-value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
  }

  .detail-value.available {
    color: var(--red);
    text-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
  }

  .about-cta {
    display: flex;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Accessibility: Reduced transparency support */
  @media (prefers-reduced-transparency: reduce) {
    .about-details {
      background: rgba(30, 30, 50, 0.95);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
