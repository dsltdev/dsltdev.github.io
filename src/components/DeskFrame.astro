---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import DeskNav from './DeskNav.astro';

interface Props {
  title: string;
  description: string;
  current: 'overview' | 'math' | 'sessions' | 'sources';
}

const { title, description, current } = Astro.props;
---

<Layout {title} {description}>
  <Navbar />
  <main class="desk-main">
    <div class="container">
      <p class="section-label" style="text-align:left;margin-bottom:0.75rem">// desk</p>
      <h1 class="desk-h1">Mercados, matemáticas y tiempo</h1>
      <p class="desk-lede">
        Lo que hay en este repo y en esta VM: un desk paper (Binance + BVC delayed),
        Kelly sin parámetros reales, y un HMAC que no puede coincidir. No hay NinjaTrader ni ticks.
      </p>
      <DeskNav {current} />
      <slot />
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .desk-main {
    position: relative;
    z-index: 1;
    padding: 7.5rem 0 4rem;
  }

  .desk-h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .desk-lede {
    color: var(--muted);
    max-width: 42rem;
    margin-bottom: 1.75rem;
    line-height: 1.7;
  }

  .desk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .desk-grid-2 {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1rem;
  }

  .desk-card {
    padding: 1.25rem 1.3rem;
  }

  .desk-card h2,
  .desk-card h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .desk-kpi {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text);
  }

  .desk-kpi small {
    display: block;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .desk-kpi.up { color: var(--success); }
  .desk-kpi.down { color: var(--danger); }
  .desk-kpi.warn { color: var(--warning); }

  .desk-muted {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .desk-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .desk-table th {
    text-align: left;
    color: var(--muted-dim);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.65rem;
    padding: 0.45rem 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .desk-table td {
    padding: 0.7rem 0.4rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    vertical-align: top;
  }

  .desk-table tr:last-child td { border-bottom: none; }

  .desk-pill {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--muted);
  }

  .desk-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .desk-list li { margin: 0.35rem 0; }

  .desk-stack { display: grid; gap: 1rem; }

  .desk-form {
    display: grid;
    gap: 0.85rem;
  }

  .desk-form label {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .desk-form input[type="number"],
  .desk-form input[type="range"] {
    accent-color: var(--accent);
  }

  .desk-form input[type="number"] {
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .desk-formula {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent-light);
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    margin: 0.5rem 0 1rem;
  }

  .desk-chart {
    width: 100%;
    height: auto;
    display: block;
  }

  .desk-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-dim);
    margin-top: 0.75rem;
  }

  .desk-gap {
    border-left: 2px solid var(--warning);
    padding: 0.85rem 1rem;
    background: rgba(201, 138, 58, 0.08);
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .desk-grid,
    .desk-grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
