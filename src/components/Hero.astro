---
---

<section id="home" class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-main">
      <p class="hero-kicker">
        <span class="hero-kicker-dot"></span>
        fintech · pagos · trading — Medellín, Colombia
      </p>

      <h1 class="hero-name">David López</h1>

      <p class="hero-prompt" aria-live="polite">
        <span class="hero-prompt-sigil">&gt;</span>
        <span class="hero-prompt-text" id="heroTyped"></span><span class="hero-prompt-cursor">_</span>
      </p>

      <p class="hero-tagline">
        Wallets, pasarelas de pago y sistemas de trading, en producción con dinero real.
      </p>

      <div class="hero-cta">
        <a href="#projects" class="btn btn-primary">
          <span>Ver proyectos</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#contact" class="btn btn-secondary">Contactar</a>
      </div>
    </div>

    <aside class="hero-audit" aria-label="Panel decorativo de log de auditoría">
      <div class="hero-audit-titlebar">
        <span class="hero-audit-dot"></span>
        <span class="hero-audit-title">tail -f audit.log</span>
        <span class="hero-audit-badge">LIVE</span>
      </div>
      <div class="hero-audit-body" id="auditLog"></div>
    </aside>
  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="hero-ticker-track">
      <span>WOMPI</span><span class="sep">/</span>
      <span>BANCOLOMBIA</span><span class="sep">/</span>
      <span>TRUORA</span><span class="sep">/</span>
      <span>CLOUDFLARE WORKERS</span><span class="sep">/</span>
      <span>TYPESCRIPT</span><span class="sep">/</span>
      <span>PYTHON</span><span class="sep">/</span>
      <span>WOMPI</span><span class="sep">/</span>
      <span>BANCOLOMBIA</span><span class="sep">/</span>
      <span>TRUORA</span><span class="sep">/</span>
      <span>CLOUDFLARE WORKERS</span><span class="sep">/</span>
      <span>TYPESCRIPT</span><span class="sep">/</span>
      <span>PYTHON</span><span class="sep">/</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 90px;
    position: relative;
    overflow: hidden;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--border) 1.5px, transparent 1.5px),
      linear-gradient(90deg, var(--border) 1.5px, transparent 1.5px);
    background-size: 80px 80px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
    opacity: 0.4;
  }

  .hero-content {
    max-width: 1240px;
    margin: 0 auto;
    padding: 2.5rem 5% 3rem;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: start;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-top: 1.5rem;
  }

  .hero-kicker {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-kicker-dot {
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, var(--accent), var(--secondary));
    border-radius: 50%;
    box-shadow: 0 0 12px var(--accent-glow);
    flex-shrink: 0;
    animation: hero-pulse 2s ease-in-out infinite;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent) 50%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-name::after {
    content: '.';
    background: linear-gradient(135deg, var(--accent), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-prompt {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent);
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    min-height: 1.6em;
  }

  .hero-prompt-sigil {
    color: var(--secondary);
    opacity: 0.8;
  }

  .hero-prompt-cursor {
    background: linear-gradient(135deg, var(--accent), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: hero-blink 1s step-end infinite;
  }

  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    color: var(--text-light);
    max-width: 520px;
    line-height: 1.7;
    margin-top: 0.25rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  /* Panel de auditoría */
  .hero-audit {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(99, 102, 241, 0.1), 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .hero-audit-titlebar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.2rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(236, 72, 153, 0.05));
    border-bottom: 1px solid var(--glass-border);
  }

  .hero-audit-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--tertiary), var(--success));
    box-shadow: 0 0 10px var(--tertiary-glow);
    animation: hero-pulse 1.4s ease-in-out infinite;
  }

  .hero-audit-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text);
  }

  .hero-audit-badge {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--success);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 50px;
    padding: 0.2rem 0.6rem;
  }

  .hero-audit-body {
    padding: 1.2rem 1.2rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 2;
    min-height: 15rem;
    color: var(--text-light);
  }

  .hero-audit-body :global(.log-row) {
    display: grid;
    grid-template-columns: 4.6rem 2.6rem 1fr;
    gap: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-audit-body :global(.log-time) { color: var(--muted); }
  .hero-audit-body :global(.log-status-200) { color: var(--tertiary); font-weight: 700; }
  .hero-audit-body :global(.log-status-401) { color: var(--warning); font-weight: 700; }
  .hero-audit-body :global(.log-status-fix) { color: var(--secondary); font-weight: 700; }
  .hero-audit-body :global(.log-path) { color: var(--text); font-weight: 500; }
  .hero-audit-body :global(.log-note) { color: var(--muted); }

  @keyframes hero-pulse {
    0%, 100% { 
      opacity: 0.7;
      transform: scale(1);
    }
    50% { 
      opacity: 1;
      transform: scale(1.1);
    }
  }

  @keyframes hero-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* Ticker de integraciones */
  .hero-ticker {
    position: relative;
    z-index: 1;
    border-top: 2px solid var(--border);
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.03), rgba(236, 72, 153, 0.03));
    overflow: hidden;
    padding: 1rem 0;
  }

  .hero-ticker-track {
    display: flex;
    gap: 2rem;
    width: max-content;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    animation: hero-ticker-scroll 32s linear infinite;
  }

  .hero-ticker-track .sep {
    color: var(--accent);
    opacity: 0.3;
  }

  @keyframes hero-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ticker-track { animation: none; }
    .hero-audit-dot { animation: none; }
    .hero-prompt-cursor { animation: none; }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
    }

    .hero-main {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
    }

    .hero-audit-body :global(.log-row) {
      grid-template-columns: 3.8rem 2.2rem 1fr;
      font-size: 0.68rem;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Efecto de escritura sobre la línea de identidad
  const typedEl = document.getElementById('heroTyped');
  const typedText = 'auditor de sistemas donde el dinero se mueve de verdad';

  if (typedEl) {
    if (prefersReducedMotion) {
      typedEl.textContent = typedText;
    } else {
      let i = 0;
      const typeNext = () => {
        if (i <= typedText.length) {
          typedEl.textContent = typedText.slice(0, i);
          i++;
          setTimeout(typeNext, 28);
        }
      };
      typeNext();
    }
  }

  // Panel de auditoría: timestamps reales (Date del navegador), rutas y montos ilustrativos
  const auditLog = document.getElementById('auditLog');

  if (auditLog) {
    const pad = (n: number) => n.toString().padStart(2, '0');
    const baseTime = new Date();
    const stamp = (offsetSec: number) => {
      const d = new Date(baseTime.getTime() + offsetSec * 1000);
      return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    };

    type Row = { offset: number; status: '200' | '401' | 'fix'; method: string; path: string; note?: string };

    const rows: Row[] = [
      { offset: 0, status: '200', method: 'GET', path: '/wallet/balance' },
      { offset: 3, status: '200', method: 'GET', path: '/wompi/transacciones' },
      { offset: 6, status: '401', method: 'POST', path: '/bancolombia/webhook', note: 'firma inválida' },
      { offset: 8, status: '200', method: 'POST', path: '/bancolombia/webhook', note: 'reintento OK' },
      { offset: 12, status: 'fix', method: '', path: 'dedup de fills', note: 'race condition corregido' },
      { offset: 16, status: '200', method: 'GET', path: '/trading/señales' },
      { offset: 20, status: '200', method: 'POST', path: '/auth/jwt', note: '7 servicios' },
    ];

    const statusLabel = (s: Row['status']) => (s === 'fix' ? 'FIX' : s);

    const buildRow = (r: Row) => {
      const div = document.createElement('div');
      div.className = 'log-row';
      div.innerHTML = `<span class="log-time">${stamp(r.offset)}</span><span class="log-status-${r.status}">${statusLabel(r.status)}</span><span class="log-path">${r.method ? r.method + ' ' : ''}${r.path}${r.note ? `<span class="log-note"> — ${r.note}</span>` : ''}</span>`;
      return div;
    };

    if (prefersReducedMotion) {
      rows.forEach((r) => auditLog.appendChild(buildRow(r)));
    } else {
      let idx = 0;
      const appendNext = () => {
        if (idx < rows.length) {
          auditLog.appendChild(buildRow(rows[idx]));
          idx++;
          setTimeout(appendNext, 420);
        } else {
          // Loop suave: reinicia el panel para mantener sensación de "live"
          setTimeout(() => {
            auditLog.innerHTML = '';
            idx = 0;
            appendNext();
          }, 4000);
        }
      };
      setTimeout(appendNext, 900);
    }
  }
</script>
