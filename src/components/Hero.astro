---
import TesseractCanvas from './TesseractCanvas.astro';
---

<section id="home" class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="hero-vanish" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-main">
      <p class="hero-kicker">
        <span class="hero-kicker-dot"></span>
        fintech · pagos · trading — Medellín, Colombia
      </p>

      <h1 class="hero-name">David López</h1>

      <p class="hero-prompt" aria-live="polite">
        <span class="hero-prompt-sigil">&gt;</span>
        <span class="hero-prompt-text" id="heroTyped"></span><span class="hero-prompt-cursor">_</span>
      </p>

      <p class="hero-tagline">
        Wallets, pasarelas de pago y sistemas de trading, en producción con dinero real.
        A la derecha: un tesseracto de verdad — rotación en W, proyección 4D→3D→2D.
      </p>

      <div class="hero-cta">
        <a href="/4d" class="btn btn-primary">Entrar al 4D</a>
        <a href="/desk" class="btn btn-outline">Desk paper</a>
        <a href="#projects" class="btn btn-secondary">
          <span>Ver proyectos</span>
        </a>
      </div>
    </div>

    <div class="hero-4d">
      <TesseractCanvas compact={true} heading="Hipercubo DSLT · eje W animado" />
    </div>
  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="hero-ticker-track">
      <span>WOMPI</span><span class="sep">/</span>
      <span>BANCOLOMBIA</span><span class="sep">/</span>
      <span>TRUORA</span><span class="sep">/</span>
      <span>CLOUDFLARE WORKERS</span><span class="sep">/</span>
      <span>TESSERACTO 4D</span><span class="sep">/</span>
      <span>TYPESCRIPT</span><span class="sep">/</span>
      <span>WOMPI</span><span class="sep">/</span>
      <span>BANCOLOMBIA</span><span class="sep">/</span>
      <span>TRUORA</span><span class="sep">/</span>
      <span>CLOUDFLARE WORKERS</span><span class="sep">/</span>
      <span>TESSERACTO 4D</span><span class="sep">/</span>
      <span>TYPESCRIPT</span><span class="sep">/</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 90px;
    position: relative;
    overflow: hidden;
    perspective: 1400px;
  }

  .hero-grid-bg {
    position: absolute;
    inset: -10% -5% 20%;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(224, 162, 62, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(224, 162, 62, 0.12) 1px, transparent 1px);
    background-size: 72px 72px;
    transform: rotateX(62deg) scale(1.35);
    transform-origin: center bottom;
    mask-image: linear-gradient(to bottom, transparent, black 30%, transparent 85%);
    opacity: 0.55;
  }

  .hero-vanish {
    position: absolute;
    left: 50%;
    top: 12%;
    width: 4px;
    height: 28%;
    background: linear-gradient(to bottom, rgba(243, 199, 120, 0.6), transparent);
    transform: translateX(-50%);
    pointer-events: none;
    filter: blur(0.4px);
  }

  .hero-content {
    max-width: 1240px;
    margin: 0 auto;
    padding: 2.5rem 5% 3rem;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2.5rem;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-top: 0.5rem;
    transform: translateZ(28px) rotateY(6deg);
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-kicker-dot {
    width: 7px;
    height: 7px;
    background: var(--success);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--success-glow);
    flex-shrink: 0;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
    text-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 0 40px rgba(224, 162, 62, 0.12);
  }

  .hero-name::after {
    content: '.';
    color: var(--accent);
  }

  .hero-prompt {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent-light);
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    min-height: 1.6em;
  }

  .hero-prompt-sigil {
    color: var(--accent);
    opacity: 0.7;
  }

  .hero-prompt-cursor {
    color: var(--accent);
    animation: hero-blink 1s step-end infinite;
  }

  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
    margin-top: 0.25rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .hero-4d {
    transform: translateZ(48px) rotateY(-8deg);
  }

  @keyframes hero-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .hero-ticker {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border-strong);
    background: linear-gradient(180deg, #1c1711 0%, #120e0a 100%);
    overflow: hidden;
    padding: 0.85rem 0;
    box-shadow: 0 -20px 40px rgba(0, 0, 0, 0.25);
    transform: translateZ(12px);
  }

  .hero-ticker-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted-dim);
    animation: hero-ticker-scroll 32s linear infinite;
  }

  .hero-ticker-track .sep {
    color: var(--border-strong);
  }

  @keyframes hero-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ticker-track { animation: none; }
    .hero-prompt-cursor { animation: none; }
    .hero-main, .hero-4d { transform: none; }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
    }

    .hero-main,
    .hero-4d {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const typedEl = document.getElementById('heroTyped');
  const typedText = 'auditor de sistemas donde el dinero se mueve de verdad';

  if (typedEl) {
    if (prefersReducedMotion) {
      typedEl.textContent = typedText;
    } else {
      let i = 0;
      const typeNext = () => {
        if (i <= typedText.length) {
          typedEl.textContent = typedText.slice(0, i);
          i++;
          setTimeout(typeNext, 28);
        }
      };
      typeNext();
    }
  }
</script>
