---
---

<section id="home" class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-main">
      <p class="hero-kicker">
        <span class="hero-kicker-dot"></span>
        David López · ingeniero de software, fintech y pagos — Medellín
      </p>

      <h1 class="hero-name">Few can build systems that actually deliver</h1>

      <p class="hero-prompt" aria-live="polite">
        <span class="hero-prompt-sigil">&gt;</span>
        <span class="hero-prompt-text" id="heroTyped"></span><span class="hero-prompt-cursor">_</span>
      </p>

      <p class="hero-tagline">
        Wallets, pasarelas de pago y sistemas de trading en producción con dinero real, y sitios web a la medida del negocio. Aquí no te pido que me creas: abajo puedes comprobarlo.
      </p>

      <div class="hero-cta">
        <a href="https://revisor-pagos.vercel.app" class="btn btn-primary" target="_blank" rel="noopener">
          <span>Revisa tu integración gratis</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#offer" class="btn btn-secondary">Ver auditoría y precios</a>
      </div>
    </div>

    <aside class="hero-audit" aria-label="Estado de mis sistemas, medido ahora desde tu navegador">
      <div class="hero-audit-titlebar">
        <span class="hero-audit-dot"></span>
        <span class="hero-audit-title">estado de los sistemas</span>
        <span class="hero-audit-badge">MEDIDO AHORA</span>
      </div>
      <div class="hero-audit-body">
        <ul class="status-list" id="statusList"></ul>
        <p class="status-note" id="statusNote">Midiendo desde tu navegador…</p>
      </div>
    </aside>
  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="hero-ticker-track">
      <span>WOMPI</span><span class="sep">/</span>
      <span>BANCOLOMBIA</span><span class="sep">/</span>
      <span>TRUORA</span><span class="sep">/</span>
      <span>CLOUDFLARE WORKERS</span><span class="sep">/</span>
      <span>TYPESCRIPT</span><span class="sep">/</span>
      <span>PYTHON</span><span class="sep">/</span>
      <span>WOMPI</span><span class="sep">/</span>
      <span>BANCOLOMBIA</span><span class="sep">/</span>
      <span>TRUORA</span><span class="sep">/</span>
      <span>CLOUDFLARE WORKERS</span><span class="sep">/</span>
      <span>TYPESCRIPT</span><span class="sep">/</span>
      <span>PYTHON</span><span class="sep">/</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 90px;
    position: relative;
    overflow: hidden;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
    opacity: 0.35;
  }

  .hero-content {
    max-width: 1240px;
    margin: 0 auto;
    padding: 2.5rem 5% 3rem;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: start;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-top: 1.5rem;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-kicker-dot {
    width: 7px;
    height: 7px;
    background: var(--success);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--success-glow);
    flex-shrink: 0;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.6vw, 3.7rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }

  .hero-name::after {
    content: '.';
    color: var(--accent);
  }

  .hero-prompt {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent-light);
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    min-height: 1.6em;
  }

  .hero-prompt-sigil {
    color: var(--accent);
    opacity: 0.7;
  }

  .hero-prompt-cursor {
    color: var(--accent);
    animation: hero-blink 1s step-end infinite;
  }

  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
    margin-top: 0.25rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  /* Panel de auditoría */
  .hero-audit {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .hero-audit-titlebar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.9rem;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
  }

  .hero-audit-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent-glow-strong);
    animation: hero-pulse 1.4s ease-in-out infinite;
  }

  .hero-audit-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .hero-audit-badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid var(--accent-glow-strong);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.4rem;
  }

  .hero-audit-body {
    padding: 0.9rem 0.9rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.9;
    min-height: 11rem;
    color: var(--muted);
  }

  .status-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .hero-audit-body :global(.status-row) {
    display: grid;
    grid-template-columns: 0.7rem 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.2rem;
    border-bottom: 1px dashed var(--border);
  }

  .hero-audit-body :global(.status-row:last-child) { border-bottom: 0; }
  .hero-audit-body :global(.status-name) { color: var(--text); text-decoration: none; }
  .hero-audit-body :global(a.status-name:hover) { color: var(--accent-light); text-decoration: underline; }
  .hero-audit-body :global(.status-what) { display: block; color: var(--muted-dim); font-size: 0.66rem; line-height: 1.3; }
  .hero-audit-body :global(.status-val) { color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
  .hero-audit-body :global(.status-dot) { width: 7px; height: 7px; border-radius: 50%; background: var(--muted-dim); }
  .hero-audit-body :global(.status-row[data-state="ok"] .status-dot) { background: var(--success); box-shadow: 0 0 8px var(--success-glow); }
  .hero-audit-body :global(.status-row[data-state="ok"] .status-val) { color: var(--success); }
  .hero-audit-body :global(.status-row[data-state="warn"] .status-dot) { background: var(--warning); }
  .hero-audit-body :global(.status-row[data-state="warn"] .status-val) { color: var(--warning); }
  .hero-audit-body :global(.status-row[data-state="fail"] .status-dot) { background: var(--danger); }
  .hero-audit-body :global(.status-row[data-state="fail"] .status-val) { color: var(--danger); }

  .status-note {
    margin: 0.9rem 0 0;
    font-size: 0.66rem;
    line-height: 1.5;
    color: var(--muted-dim);
  }

  @keyframes hero-pulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  @keyframes hero-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* Ticker de integraciones */
  .hero-ticker {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
    padding: 0.85rem 0;
  }

  .hero-ticker-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted-dim);
    animation: hero-ticker-scroll 32s linear infinite;
  }

  .hero-ticker-track .sep {
    color: var(--border-strong);
  }

  @keyframes hero-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ticker-track { animation: none; }
    .hero-audit-dot { animation: none; }
    .hero-prompt-cursor { animation: none; }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
    }

    .hero-main {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
    }

    .hero-audit-body :global(.status-row) {
      font-size: 0.7rem;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Efecto de escritura sobre la línea de identidad
  const typedEl = document.getElementById('heroTyped');
  const typedText = 'construyo sistemas donde el dinero se mueve de verdad';

  if (typedEl) {
    if (prefersReducedMotion) {
      typedEl.textContent = typedText;
    } else {
      let i = 0;
      const typeNext = () => {
        if (i <= typedText.length) {
          typedEl.textContent = typedText.slice(0, i);
          i++;
          setTimeout(typeNext, 28);
        }
      };
      typeNext();
    }
  }

  // Estado de los sistemas: mediciones reales hechas desde el navegador del visitante.
  // Solo comprueba que el servicio responda y cuánto tarda; no mide pagos ni ingresos.
  type Svc = { name: string; what: string; url: string; href: string };
  type Result = { state: 'ok' | 'warn' | 'fail'; text: string };

  const services: Svc[] = [
    { name: 'Revisor de Pagos', what: 'herramienta gratis · Vercel', url: 'https://revisor-pagos.vercel.app/', href: 'https://revisor-pagos.vercel.app' },
    { name: 'Chat de IA', what: 'Cloudflare Worker · créditos prepagados', url: 'https://chat.dsltdev.com/', href: 'https://chat.dsltdev.com' },
  ];

  const statusList = document.getElementById('statusList');
  const statusNote = document.getElementById('statusNote');

  if (statusList && statusNote) {
    const rows = services.map((svc) => {
      const li = document.createElement('li');
      li.className = 'status-row';
      li.dataset.state = 'pending';
      li.innerHTML = `<span class="status-dot"></span><span><a class="status-name" href="${svc.href}" target="_blank" rel="noopener">${svc.name}</a><span class="status-what">${svc.what}</span></span><span class="status-val">…</span>`;
      statusList.appendChild(li);
      return { svc, li, val: li.querySelector('.status-val') as HTMLElement };
    });

    const probe = async (svc: Svc): Promise<Result> => {
      const t0 = performance.now();
      const ms = () => Math.round(performance.now() - t0);
      try {
        const res = await fetch(svc.url, { cache: 'no-store', signal: AbortSignal.timeout(8000) });
        res.body?.cancel();
        return res.ok ? { state: 'ok', text: `HTTP ${res.status} · ${ms()} ms` } : { state: 'fail', text: `HTTP ${res.status}` };
      } catch {
        // Si el servidor no permite leer la respuesta (CORS), al menos se puede saber si contesta.
        try {
          await fetch(svc.url, { mode: 'no-cors', cache: 'no-store', signal: AbortSignal.timeout(8000) });
          return { state: 'warn', text: `responde · ${ms()} ms` };
        } catch {
          return { state: 'fail', text: 'sin respuesta' };
        }
      }
    };

    const pad = (n: number) => n.toString().padStart(2, '0');
    const measure = async () => {
      const results = await Promise.all(rows.map((r) => probe(r.svc)));
      rows.forEach((r, i) => {
        r.li.dataset.state = results[i].state;
        r.val.textContent = results[i].text;
      });
      const d = new Date();
      statusNote.textContent = `Medido a las ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())} desde tu navegador, cada 60 s. Solo comprueba que respondan; no mide pagos.`;
    };

    measure();
    setInterval(() => { if (!document.hidden) measure(); }, 60000);
  }
</script>
