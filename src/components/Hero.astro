---
---

<section id="home" class="hero">
  <div class="hero-bg">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-grid"></div>
  </div>
  
  <div class="hero-content">
    <div class="hero-text">
      <div class="hero-label animate-fade-in-up">
        <span class="hero-dot"></span>
        Full Stack Developer / Medellín
      </div>
      
      <h1 class="hero-name animate-fade-in-up delay-100">
        David<br>
        López
      </h1>
      
      <p class="hero-tagline animate-fade-in-up delay-200">
        Construyo cosas para internet.
      </p>

      <div class="hero-cta animate-fade-in-up delay-300">
        <a href="#projects" class="btn btn-primary">
          <span>Ver proyectos</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#contact" class="btn btn-secondary">Contactar</a>
      </div>

      <div class="hero-stats animate-fade-in-up delay-400">
        <div class="stat">
          <span class="stat-number">5+</span>
          <span class="stat-label">años</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">50+</span>
          <span class="stat-label">proyectos</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">30+</span>
          <span class="stat-label">clientes</span>
        </div>
      </div>
    </div>

    <div class="hero-visual animate-fade-in-up delay-300">
      <div class="code-block">
        <div class="code-header">
          <div class="code-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="code-filename">developer.ts</span>
        </div>
        <pre><code><span class="code-keyword">const</span> <span class="code-var">developer</span> = {'{'}
  <span class="code-prop">name</span>: <span class="code-string">"David López"</span>,
  <span class="code-prop">role</span>: <span class="code-string">"Full Stack Dev"</span>,
  <span class="code-prop">status</span>: <span class="code-string">"disponible"</span>
{'}'};

<span class="code-keyword">export default</span> <span class="code-var">developer</span>;</code></pre>
        <div class="code-glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: float 8s ease-in-out infinite;
  }

  .hero-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 230, 138, 0.2) 0%, transparent 70%);
    top: -10%;
    left: -5%;
    animation-delay: 0s;
  }

  .hero-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 179, 107, 0.15) 0%, transparent 70%);
    bottom: -10%;
    right: -5%;
    animation-delay: -4s;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(0, 230, 138, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 230, 138, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
  }

  .hero-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 5%;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--accent);
    animation: glow 2s ease-in-out infinite;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent-light) 50%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: 1.3rem;
    color: var(--muted);
    max-width: 400px;
    line-height: 1.7;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, var(--border), transparent);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .code-block {
    background: rgba(5, 10, 8, 0.8);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(0, 230, 138, 0.05),
      inset 0 1px 0 rgba(0, 230, 138, 0.1);
    width: 100%;
    max-width: 420px;
    transition: all 0.5s var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .code-block:hover {
    border-color: rgba(0, 230, 138, 0.25);
    box-shadow: 
      0 16px 48px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(0, 230, 138, 0.1),
      0 0 60px rgba(0, 230, 138, 0.08);
    transform: translateY(-6px);
  }

  .code-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(0, 230, 138, 0.06) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .code-block:hover .code-glow {
    opacity: 1;
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid rgba(0, 230, 138, 0.08);
  }

  .code-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  .code-filename {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .code-block pre {
    margin: 0;
    padding: 1.25rem;
  }

  .code-block code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    color: rgba(232, 245, 238, 0.8);
  }

  .code-keyword { color: #c792ea; }
  .code-var { color: #82aaff; }
  .code-prop { color: #00e68a; }
  .code-string { color: #c3e88d; }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.05); }
  }

  @keyframes glow {
    0%, 100% { opacity: 0.5; box-shadow: 0 0 12px var(--accent); }
    50% { opacity: 1; box-shadow: 0 0 20px var(--accent), 0 0 40px rgba(0, 230, 138, 0.3); }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .hero-visual {
      order: -1;
    }

    .code-block {
      max-width: 100%;
    }

    .hero-bg {
      opacity: 0.5;
    }
  }

  @media (max-width: 640px) {
    .hero-name {
      font-size: clamp(3rem, 12vw, 5rem);
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-stats {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .stat-divider {
      width: 40px;
      height: 1px;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .code-block {
      background: rgba(12, 22, 16, 0.98);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .hero-orb {
      display: none;
    }
  }
</style>
