---
const projects = [
  {
    title: "E-Commerce Platform",
    description: "Plataforma de comercio electrónico completa. Panel admin, pagos, analytics.",
    tags: ["React", "Node.js", "MongoDB"],
    year: "2024",
    link: "#",
    github: "#"
  },
  {
    title: "AI Task Manager",
    description: "Gestión de tareas potenciada por IA. Aprende patrones, optimiza productividad.",
    tags: ["Next.js", "Python", "OpenAI"],
    year: "2024",
    link: "#",
    github: "#"
  },
  {
    title: "Real-time Dashboard",
    description: "Dashboard de datos en tiempo real. Visualizaciones y alertas.",
    tags: ["Vue.js", "D3.js", "WebSocket"],
    year: "2023",
    link: "#",
    github: "#"
  },
  {
    title: "Social Media App",
    description: "Red social móvil. Feeds, stories, mensajería instantánea.",
    tags: ["React Native", "Firebase"],
    year: "2023",
    link: "#",
    github: "#"
  }
];
---

<section id="projects" class="projects">
  <div class="container">
    <div class="projects-header">
      <div>
        <p class="section-label">// 002</p>
        <h2 class="section-title">Proyectos</h2>
      </div>
      <a href="https://github.com/dsltdev" class="btn btn-secondary" target="_blank">GitHub →</a>
    </div>

    <div class="projects-grid">
      {projects.map((project, index) => (
        <article class="project-card">
          <div class="project-number">{String(index + 1).padStart(2, '0')}</div>
          
          <div class="project-content">
            <div class="project-header">
              <h3 class="project-title">{project.title}</h3>
              <span class="project-year">{project.year}</span>
            </div>
            
            <p class="project-description">{project.description}</p>
            
            <div class="project-tags">
              {project.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>

          <div class="project-links">
            <a href={project.link} class="project-link">Ver ↗</a>
            <a href={project.github} class="project-link">Código ↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    background: transparent;
  }

  .project-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    box-shadow: var(--glass-shadow);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: all 0.4s var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 230, 138, 0.3), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project-card:hover {
    background: var(--glass-bg-hover);
    border-color: rgba(0, 230, 138, 0.2);
    box-shadow: 0 16px 48px rgba(0, 230, 138, 0.08), 0 8px 32px rgba(0, 0, 0, 0.4);
    transform: translateY(-6px);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-number {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    opacity: 0.6;
  }

  .project-content {
    flex: 1;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .project-title {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .project-year {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .project-description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.625rem;
    background: rgba(0, 230, 138, 0.06);
    color: var(--accent);
    border: 1px solid rgba(0, 230, 138, 0.12);
    border-radius: 999px;
    transition: all 0.3s ease;
  }

  .tag:hover {
    background: rgba(0, 230, 138, 0.12);
    border-color: rgba(0, 230, 138, 0.25);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 230, 138, 0.06);
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
    transition: all 0.3s ease;
    position: relative;
  }

  .project-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease-out);
  }

  .project-link:hover {
    color: var(--accent);
  }

  .project-link:hover::after {
    width: 100%;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-header {
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .project-card {
      background: rgba(12, 22, 16, 0.98);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
