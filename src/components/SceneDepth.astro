---

<div class="depth-world" aria-hidden="true">
  <div class="depth-horizon"></div>
  <div class="depth-grid"></div>
  <div class="depth-cube c1"></div>
  <div class="depth-cube c2"></div>
  <div class="depth-cube c3"></div>
  <div class="depth-lamp"></div>
</div>

<style>
  .depth-world {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    perspective: 900px;
    perspective-origin: 50% 35%;
    overflow: hidden;
  }

  .depth-horizon {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(224, 162, 62, 0.16), transparent 55%),
      radial-gradient(ellipse 60% 40% at 90% 80%, rgba(90, 50, 10, 0.35), transparent 60%);
  }

  .depth-grid {
    position: absolute;
    left: -20%;
    right: -20%;
    bottom: -35%;
    height: 70%;
    background-image:
      linear-gradient(rgba(224, 162, 62, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(224, 162, 62, 0.18) 1px, transparent 1px);
    background-size: 56px 56px;
    transform: rotateX(68deg) translateZ(-120px);
    mask-image: linear-gradient(to top, rgba(0,0,0,0.7), transparent 75%);
  }

  .depth-cube {
    position: absolute;
    width: 88px;
    height: 88px;
    border: 1px solid rgba(224, 162, 62, 0.35);
    background: linear-gradient(145deg, rgba(224, 162, 62, 0.12), rgba(20, 16, 11, 0.4));
    box-shadow:
      14px 18px 0 -4px rgba(10, 8, 5, 0.85),
      0 30px 50px rgba(0, 0, 0, 0.35),
      inset 0 0 24px rgba(243, 199, 120, 0.12);
    transform-style: preserve-3d;
    animation: cube-orbit 22s linear infinite;
  }

  .c1 { top: 18%; left: 8%; animation-duration: 26s; }
  .c2 { top: 62%; right: 10%; width: 56px; height: 56px; animation-duration: 18s; animation-direction: reverse; }
  .c3 { top: 36%; right: 28%; width: 40px; height: 40px; opacity: 0.7; animation-duration: 32s; }

  .depth-lamp {
    position: absolute;
    top: -8%;
    left: 20%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(255, 210, 130, 0.18), transparent 62%);
    filter: blur(8px);
  }

  @keyframes cube-orbit {
    from { transform: rotateX(18deg) rotateY(0deg) translateZ(40px); }
    to { transform: rotateX(18deg) rotateY(360deg) translateZ(40px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .depth-cube { animation: none; }
  }

  @media (max-width: 700px) {
    .c3 { display: none; }
    .depth-cube { opacity: 0.45; }
  }
</style>
