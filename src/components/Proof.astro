---
// Cada tarjeta afirma algo y enlaza a donde se puede comprobar. Si una afirmación no
// tiene enlace de evidencia, no entra aquí.
const proofs = [
  {
    tag: "Caso real",
    title: "Un webhook rechazaba cada pago real, en silencio",
    body: "Respondía 401 «firma inválida», que es justo lo correcto ante una firma falsa. Nada gritaba que estuviera roto. Wompi firma los webhooks de Payouts con otro secreto y manda el timestamp en otro sitio. Está explicado con la causa y la corrección.",
    proves: "Qué demuestra: encuentro fallas que las pruebas normales no ven.",
    href: "/blog/webhook-payouts-wompi-firma-invalida",
    cta: "Leer el caso",
    external: false,
  },
  {
    tag: "Herramienta gratis",
    title: "Revisor de Pagos: 22 controles y 76 pruebas automáticas",
    body: "Pega el código de tu webhook o checkout de Wompi y marca firmas mal verificadas, duplicados y montos en centavos. Corre en tu navegador: tu código no sale de ahí, y puedes comprobarlo en las cabeceras de seguridad de la página.",
    proves: "Qué demuestra: construyo herramientas que se pueden usar hoy, sin registrarse.",
    href: "https://revisor-pagos.vercel.app",
    cta: "Probarla ahora",
    external: true,
  },
  {
    tag: "Lo que no funcionó",
    title: "Mis experimentos de trading, medidos y descartados",
    body: "Probé señales de trading con pruebas estadísticas serias y no encontré una ventaja demostrable. Lo publico en vez de venderlo. Quien mide su propio trabajo y dice el resultado es quien te dirá la verdad sobre tu integración.",
    proves: "Qué demuestra: no te voy a decir que está bien algo que no lo está.",
    href: "#projects",
    cta: "Ver el proyecto y su estado",
    external: false,
  },
];
---

<section id="proof" class="proof">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="section-label">Pruebas</p>
      <h2 class="section-title">Verifícalo tú mismo</h2>
      <p class="section-subtitle">
        Todo lo que afirmo tiene un enlace donde puedes comprobarlo. Lo que no se puede comprobar, no lo afirmo.
      </p>
    </div>

    <div class="proof-grid" data-reveal-group>
      {proofs.map((p) => (
        <article class="proof-card glass-card" data-reveal>
          <span class="proof-tag">{p.tag}</span>
          <h3 class="proof-title">{p.title}</h3>
          <p class="proof-body">{p.body}</p>
          <p class="proof-proves">{p.proves}</p>
          <a
            class="proof-link"
            href={p.href}
            target={p.external ? "_blank" : undefined}
            rel={p.external ? "noopener" : undefined}
          >
            {p.cta} {p.external ? "↗" : "→"}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proof { padding: 5rem 0 2rem; }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .proof-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.75rem;
  }

  .proof-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-light);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.5rem;
  }

  .proof-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--text);
    margin: 0;
  }

  .proof-body {
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
    font-size: 0.95rem;
  }

  .proof-proves {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text);
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
    line-height: 1.5;
  }

  .proof-link {
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-light);
    text-decoration: none;
  }
  .proof-link:hover { text-decoration: underline; }
  .proof-link:focus-visible { outline: 2px solid var(--accent-light); outline-offset: 3px; }

  @media (max-width: 960px) {
    .proof-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
