---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada — David López"
  description="Esta página no existe. Vuelve al inicio o revisa el blog."
  noindex={true}
  depth={false}
>
  <main class="nf">
    <p class="nf-code">404</p>
    <h1>Esta página no existe.</h1>
    <p class="nf-text">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <p class="nf-links">
      <a href="/">Ir al inicio</a>
      <a href="/blog">Ver el blog</a>
      <a href="/app/">Entrar al panel</a>
    </p>
  </main>
</Layout>

<style>
  .nf {
    position: relative;
    z-index: 1;
    max-width: 560px;
    margin: 0 auto;
    padding: 18vh 1.25rem 4rem;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin: 0 0 1rem;
  }
  .nf-text {
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 1.75rem;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .nf-links a {
    color: var(--accent-light);
    padding-block: 0.4rem;
  }
</style>
