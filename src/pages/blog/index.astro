---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'webhook-payouts-wompi-firma-invalida',
    title: 'El webhook que rechazaba cada pago real',
    description: 'Un caso real: por qué la confirmación de Wompi Payouts nunca validaba, y cómo lo encontré revisando código en producción.',
    date: '2026-09-16',
  },
];
---

<Layout title="Blog — David López" description="Casos reales de bugs en integraciones de pago, encontrados y corregidos en producción.">
  <Navbar />
  <main class="container blog-index">
    <div class="section-header" style="text-align:left; margin-bottom: 3rem;">
      <p class="section-label">Blog</p>
      <h1 class="section-title">Bugs reales, no hipotéticos.</h1>
      <p class="section-subtitle" style="margin:0">Casos de integraciones de pago que encontré y corregí en sistemas en producción.</p>
    </div>

    <div class="post-list">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="post-item glass-card">
          <span class="post-date">{p.date}</span>
          <h2 class="post-title">{p.title}</h2>
          <p class="post-desc">{p.description}</p>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blog-index {
    padding-top: 140px;
    padding-bottom: 100px;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 680px;
  }

  .post-item {
    display: block;
    padding: 1.75rem 2rem;
    text-decoration: none;
    transition: transform 0.25s var(--ease-out), border-color 0.25s ease;
  }

  .post-item:hover {
    transform: translateY(-2px);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin: 0.5rem 0 0.5rem;
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--ink-soft, var(--muted));
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 640px) {
    .blog-index { padding-top: 110px; }
  }
</style>
