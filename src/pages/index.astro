---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
---

<Layout title="DSLT — Desarrollo web para negocios en Colombia" description="Creamos sitios web y apps que venden. Para negocios en Medellín y toda Colombia.">
  <Loader />
  <ScrollProgress />
  <Navbar />

  <main>
    <section id="hero" class="hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-grid"></div>
      </div>
      <div class="container">
        <div class="hero-content" data-reveal-group>
          <div class="hero-text" data-reveal>
            <span class="badge">DSLT · Medellín</span>
            <h1>Tu negocio necesita<br><span class="accent">presencia digital.</span></h1>
            <p class="hero-subtitle">
              Sitios web, apps y sistemas que realmente venden. Sin complicaciones, sin mensualidades ocultas.
            </p>
            <div class="hero-cta">
              <a href="#contact" class="btn btn-primary">Hablemos →</a>
              <a href="#services" class="btn btn-secondary">Ver servicios</a>
            </div>
          </div>
          <div class="hero-visual" data-reveal>
            <div class="glass-card hero-card">
              <div class="card-header">
                <span class="card-dot"></span>
                <span class="card-title">dsltd</span>
              </div>
              <div class="card-body">
                <div class="card-stat">
                  <span class="stat-value">50+</span>
                  <span class="stat-label">proyectos lanzados</span>
                </div>
                <div class="card-stat">
                  <span class="stat-value">30+</span>
                  <span class="stat-label">clientes activos</span>
                </div>
                <div class="card-stat">
                  <span class="stat-value">5+</span>
                  <span class="stat-label">años de experiencia</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="product-showcase">
      <div class="container">
        <div class="product-showcase-grid">
          <div class="product-showcase-text">
            <span class="section-label">// PRODUCTO</span>
            <h2 class="section-title">DSLT Content Generator</h2>
            <p class="section-subtitle" style="text-align:left;max-width:100%">
              Generador de contenido para negocios en Colombia. Escribís qué vendés, te devolvemos posts de Instagram, WhatsApp y guiones de historia — en el tono de acá, listo para copiar.
            </p>
            <div class="product-facts">
              <span><strong>300</strong> créditos gratis</span>
              <span><strong>Sin</strong> mensualidad</span>
              <span>Pago en <strong>COP</strong></span>
            </div>
            <a href="/app" class="btn btn-primary" style="margin-top:1rem">Probar gratis →</a>
          </div>
          <div class="product-showcase-visual">
            <div class="product-card-preview">
              <div class="product-card-bar">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              </div>
              <div class="product-post-preview">
                <div class="product-post-meta">Instagram · Arepería Laureles</div>
                <h3>Hoy sí hay de todo.</h3>
                <p>Arepas rellenas, domicilio hasta las 10. Si estás por la 70, pedí por WhatsApp y en 20 minutos estás comiendo.</p>
                <div class="product-post-tags">#Laureles #Medellín #Domicilio</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pricing-preview">
      <div class="container">
        <div class="pricing-preview-grid" data-reveal-group>
          <div class="pricing-preview-text" data-reveal>
            <span class="section-label">// PRECIOS</span>
            <h2 class="section-title">Empezá gratis.<br>Escalá cuando quieras.</h2>
            <p class="section-subtitle" style="text-align:left;max-width:100%">
              300 créditos gratis al registrarte. Sin tarjeta, sin compromiso. Cuando tu negocio necesite más, elegí el plan que mejor se adapte.
            </p>
            <div class="pricing-preview-tiers">
              <div class="tier-item">
                <span class="tier-name">Gratis</span>
                <span class="tier-price">$0</span>
                <span class="tier-desc">300 créditos</span>
              </div>
              <div class="tier-item tier-highlight">
                <span class="tier-name">Pro</span>
                <span class="tier-price">$19.900<span class="tier-currency">COP</span></span>
                <span class="tier-desc">50.000 créditos/mes</span>
              </div>
              <div class="tier-item">
                <span class="tier-name">Business</span>
                <span class="tier-price">$49.900<span class="tier-currency">COP</span></span>
                <span class="tier-desc">200.000 créditos/mes</span>
              </div>
            </div>
            <a href="/pricing" class="btn btn-secondary" style="margin-top:1rem">Ver todos los planes →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="services">
      <div class="container">
        <div class="section-header" data-reveal>
          <span class="section-label">// SERVICIOS</span>
          <h2 class="section-title">Lo que hacemos</h2>
          <p class="section-subtitle">Soluciones digitales completas para negocios que quieren crecer.</p>
        </div>

        <div class="services-grid" data-reveal-group>
          <div class="service-card glass-card" data-reveal>
            <div class="service-icon">🌐</div>
            <h3>Sitios web</h3>
            <p>Sitios modernos, rápidos y que convierten visitantes en clientes. Landing pages, sitios corporativos, e-commerce.</p>
          </div>

          <div class="service-card glass-card" data-reveal>
            <div class="service-icon">📱</div>
            <h3>Apps móviles</h3>
            <p>Aplicaciones para iOS y Android que tus clientes van a querer usar. React Native, Flutter.</p>
          </div>

          <div class="service-card glass-card" data-reveal>
            <div class="service-icon">⚡</div>
            <h3>Sistemas a medida</h3>
            <p>CRMs, dashboards, plataformas internas. Automatizá lo que hoy hacés a mano.</p>
          </div>

          <div class="service-card glass-card" data-reveal>
            <div class="service-icon">🤖</div>
            <h3>IA & Automatización</h3>
            <p>Chatbots, generación de contenido, workflows con inteligencia artificial integrada.</p>
          </div>

          <div class="service-card glass-card" data-reveal>
            <div class="service-icon">✍️</div>
            <h3>Generador de contenido</h3>
            <p>Herramienta SaaS para generar posts de Instagram, WhatsApp y historias para negocios en Colombia.</p>
          </div>

          <div class="service-card glass-card" data-reveal>
            <div class="service-icon">🎨</div>
            <h3>Diseño UI/UX</h3>
            <p>Interfaces que se sienten bien. Diseño centrado en el usuario, prototipos rápidos.</p>
          </div>

          <div class="service-card glass-card" data-reveal>
            <div class="service-icon">☁️</div>
            <h3>Infraestructura</h3>
            <p>Deploy, DNS, dominios, hosting. Nos encargamos de que todo funcione sin que te preocupes.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="portfolio" class="portfolio">
      <div class="container">
        <div class="section-header" data-reveal>
          <span class="section-label">// PORTAFOLIO</span>
          <h2 class="section-title">Proyectos recientes</h2>
          <p class="section-subtitle">Algo de lo que ya hicimos.</p>
        </div>

        <div class="portfolio-grid" data-reveal-group>
          <article class="project-card glass-card" data-reveal>
            <div class="project-image">
              <div class="project-placeholder">📱</div>
            </div>
            <div class="project-content">
              <div class="project-meta">
                <span class="project-year">2024</span>
                <span class="project-type">E-Commerce</span>
              </div>
              <h3 class="project-title">Tienda Online La Arepera</h3>
              <p class="project-desc">Plataforma de pedidos para arepería en Medellín. Pedidos por WhatsApp, pagos en línea, panel admin.</p>
              <div class="project-tags">
                <span class="tag">React</span>
                <span class="tag">Node.js</span>
                <span class="tag">WhatsApp API</span>
              </div>
            </div>
          </article>

          <article class="project-card glass-card" data-reveal>
            <div class="project-image">
              <div class="project-placeholder">🤖</div>
            </div>
            <div class="project-content">
              <div class="project-meta">
                <span class="project-year">2024</span>
                <span class="project-type">IA / Automatización</span>
              </div>
              <h3 class="project-title">DSLT Content Generator</h3>
              <p class="project-desc">Generador de contenido para redes sociales con IA. Instagram, WhatsApp, historias — en el tono de cada negocio colombiano.</p>
              <div class="project-tags">
                <span class="tag">Astro</span>
                <span class="tag">Cloudflare Workers</span>
                <span class="tag">OpenAI</span>
              </div>
            </div>
          </article>

          <article class="project-card glass-card" data-reveal>
            <div class="project-image">
              <div class="project-placeholder">📊</div>
            </div>
            <div class="project-content">
              <div class="project-meta">
                <span class="project-year">2023</span>
                <span class="project-type">Dashboard</span>
              </div>
              <h3 class="project-title">Panel de Trading</h3>
              <p class="project-desc">Dashboard en tiempo real para monitoreo de mercados. Gráficos, alertas, ejecución de órdenes.</p>
              <div class="project-tags">
                <span class="tag">React</span>
                <span class="tag">WebSocket</span>
                <span class="tag">D3.js</span>
              </div>
            </div>
          </article>

          <article class="project-card glass-card" data-reveal>
            <div class="project-image">
              <div class="project-placeholder">🏥</div>
            </div>
            <div class="project-content">
              <div class="project-meta">
                <span class="project-year">2023</span>
                <span class="project-type">SaaS</span>
              </div>
              <h3 class="project-title">Sistema de Citas Médicas</h3>
              <p class="project-desc">Plataforma para clínicas. Agendamiento, recordatorios, historial clínico, facturación.</p>
              <div class="project-tags">
                <span class="tag">Next.js</span>
                <span class="tag">PostgreSQL</span>
                <span class="tag">Stripe</span>
              </div>
            </div>
          </article>
        </div>

        <div class="portfolio-cta">
          <a href="https://github.com/dsltdev" class="btn btn-secondary" target="_blank">Ver más en GitHub →</a>
        </div>
      </div>
    </section>

    <section id="process" class="process">
      <div class="container">
        <div class="section-header" data-reveal>
          <span class="section-label">// PROCESO</span>
          <h2 class="section-title">Cómo trabajamos</h2>
          <p class="section-subtitle">Simple, rápido y sin sorpresas.</p>
        </div>

        <div class="process-grid" data-reveal-group>
          <div class="process-step" data-reveal>
            <div class="step-number">01</div>
            <h3>Conversamos</h3>
            <p>Nos contás qué necesitás. Sin formularios eternos, sin jerga técnica.</p>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step" data-reveal>
            <div class="step-number">02</div>
            <h3>Diseñamos</h3>
            <p>Te mostramos cómo va a quedar antes de escribir una línea de código.</p>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step" data-reveal>
            <div class="step-number">03</div>
            <h3>Construimos</h3>
            <p>Desarrollamos tu proyecto en sprints cortos. Vos ves el progreso en tiempo real.</p>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step" data-reveal>
            <div class="step-number">04</div>
            <h3>Lanzamos</h3>
            <p>Deploy, configuración, soporte. Tu negocio online funcionando.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="tech" class="tech">
      <div class="container">
        <div class="section-header" data-reveal>
          <span class="section-label">// STACK</span>
          <h2 class="section-title">Tecnologías</h2>
          <p class="section-subtitle">Elegimos la herramienta correcta para cada proyecto.</p>
        </div>

        <div class="tech-tags" data-reveal-group>
          <span class="tech-tag" data-reveal>React</span>
          <span class="tech-tag" data-reveal>Next.js</span>
          <span class="tech-tag" data-reveal>TypeScript</span>
          <span class="tech-tag" data-reveal>Node.js</span>
          <span class="tech-tag" data-reveal>Python</span>
          <span class="tech-tag" data-reveal>PostgreSQL</span>
          <span class="tech-tag" data-reveal>Docker</span>
          <span class="tech-tag" data-reveal>AWS</span>
          <span class="tech-tag" data-reveal>Cloudflare</span>
          <span class="tech-tag" data-reveal>Tailwind</span>
          <span class="tech-tag" data-reveal>React Native</span>
          <span class="tech-tag" data-reveal>Firebase</span>
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="container">
        <div class="contact-grid" data-reveal-group>
          <div class="contact-left" data-reveal>
            <span class="section-label">// CONTACTO</span>
            <h2 class="section-title">¿Listo para empezar?</h2>
            <p class="section-subtitle">Contanos tu idea. Sin compromiso, sin costo.</p>

            <div class="contact-methods">
              <a href="mailto:dsltdev@icloud.com" class="contact-method glass-card">
                <span class="method-label">Email</span>
                <span class="method-value">dsltdev@icloud.com</span>
              </a>
              <a href="https://github.com/dsltdev" class="contact-method glass-card" target="_blank">
                <span class="method-label">GitHub</span>
                <span class="method-value">@dsltdev</span>
              </a>
              <a href="https://linkedin.com/in/davidlopez" class="contact-method glass-card" target="_blank">
                <span class="method-label">LinkedIn</span>
                <span class="method-value">/in/davidlopez</span>
              </a>
            </div>
          </div>

          <div class="contact-right" data-reveal>
            <form class="contact-form glass-card" action="https://formspree.io/f/xwkzbgln" method="POST">
              <div class="form-group">
                <label for="name">Nombre</label>
                <input type="text" id="name" name="name" required placeholder="Tu nombre">
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required placeholder="tu@email.com">
              </div>
              <div class="form-group">
                <label for="message">¿Qué necesitás?</label>
                <textarea id="message" name="message" rows="5" required placeholder="Contanos sobre tu proyecto..."></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Enviar →</button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Product Showcase */
  .product-showcase {
    position: relative;
    z-index: 1;
    padding: 80px 0;
  }

  .product-showcase-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .product-showcase-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-facts {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .product-facts strong {
    color: var(--text);
    font-weight: 650;
  }

  .product-showcase-visual {
    display: flex;
    justify-content: center;
  }

  .product-card-preview {
    width: 100%;
    max-width: 380px;
    background: #F3EEE6;
    border: 1px solid #D9D0C3;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 18px 40px rgba(28, 25, 22, 0.15);
  }

  .product-card-bar {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }

  .product-card-bar .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #D9D0C3;
  }

  .product-post-preview {
    border: 1px solid #D9D0C3;
    border-radius: 10px;
    padding: 1rem 1.05rem;
    background: #fff;
  }

  .product-post-meta {
    font-size: 0.75rem;
    color: #6B635A;
    margin-bottom: 0.45rem;
  }

  .product-post-preview h3 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
    color: #1C1916;
  }

  .product-post-preview p {
    font-size: 0.92rem;
    color: #3a342e;
    line-height: 1.5;
  }

  .product-post-tags {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    color: #8E2E12;
  }

  @media (max-width: 860px) {
    .product-showcase-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: float 8s ease-in-out infinite;
  }

  .hero-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 230, 138, 0.18) 0%, transparent 70%);
    top: -10%;
    left: -5%;
  }

  .hero-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 179, 107, 0.12) 0%, transparent 70%);
    bottom: -10%;
    right: -5%;
    animation-delay: -4s;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 230, 138, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 230, 138, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-text h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text);
  }

  .accent {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 480px;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-card {
    width: 100%;
    max-width: 380px;
    padding: 0;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(0, 230, 138, 0.08);
  }

  .card-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--accent);
    animation: glow 2s ease-in-out infinite;
  }

  .card-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Pricing Preview */
  .pricing-preview {
    position: relative;
    z-index: 1;
    padding: 80px 0;
  }

  .pricing-preview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  .pricing-preview-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pricing-preview-tiers {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .tier-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    background: rgba(0, 230, 138, 0.03);
    border: 1px solid rgba(0, 230, 138, 0.08);
    border-radius: var(--radius-sm);
    min-width: 140px;
    transition: all 0.3s ease;
  }

  .tier-item:hover {
    border-color: rgba(0, 230, 138, 0.2);
    background: rgba(0, 230, 138, 0.06);
  }

  .tier-highlight {
    border-color: rgba(0, 230, 138, 0.25);
    background: rgba(0, 230, 138, 0.06);
  }

  .tier-name {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .tier-price {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
  }

  .tier-currency {
    font-size: 0.7rem;
    color: var(--muted);
    font-weight: 400;
    margin-left: 0.2rem;
  }

  .tier-desc {
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* Services */
  .services {
    position: relative;
    z-index: 1;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
