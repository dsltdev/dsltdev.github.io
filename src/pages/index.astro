---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Pagos Idle — juego clicker gratis"
  description="Procesa pagos, compra webhooks, pasarelas y exchanges y construye tu imperio fintech. Juego idle 2D gratis en el navegador, sin descargas."
  image="/og-juego.png"
  siteName="Pagos Idle"
  depth={false}
>
  <main class="pi">
    <header class="pi-top">
      <span class="pi-side"><a class="pi-link" href="/trading">📈 Mesa de trading</a></span>
      <h1 class="pi-title"><span>[</span>Pagos Idle<span>]</span></h1>
      <span class="pi-side pi-side--end">
        <a id="donate" class="pi-link" href="#" target="_blank" rel="noopener" hidden>♥ Apoyar</a>
        <button id="sound" class="pi-icon" type="button" aria-pressed="true" aria-label="Sonido y vibración: activados" title="Sonido y vibración">🔊</button>
      </span>
    </header>

    <div class="pi-hud" aria-live="off">
      <div class="pi-stat">
        <span class="pi-label">Saldo</span>
        <strong id="coins" class="pi-big">0</strong>
      </div>
      <div class="pi-stat">
        <span class="pi-label">Por segundo</span>
        <strong id="cps" class="pi-big pi-big--sm">0</strong>
      </div>
      <div class="pi-stat">
        <span class="pi-label">Por click</span>
        <strong id="click-power" class="pi-big pi-big--sm">1</strong>
      </div>
      <div class="pi-badges">
        <div id="frenzy" class="pi-boost pi-boost--frenzy" hidden>🔥 Frenesí x5 · <span id="frenzy-left"></span></div>
        <div id="boost" class="pi-boost" hidden>⚡ x2 · <span id="boost-left"></span></div>
      </div>
    </div>

    <div class="pi-layout">
      <div class="pi-stage">
        <canvas id="scene" tabindex="0" role="button" aria-label="Procesar un pago: pulsa Enter o haz click en la moneda"></canvas>
        <p id="hint" class="pi-hint" aria-live="polite">Toca la moneda para procesar pagos.</p>
      </div>

      <aside class="pi-panel glass-card">
        <div class="pi-tabs" role="tablist" aria-label="Menú del juego">
          <button role="tab" id="tab-gens" aria-controls="panel-gens" aria-selected="true" data-tab="gens">Negocios</button>
          <button role="tab" id="tab-upgrades" aria-controls="panel-upgrades" aria-selected="false" data-tab="upgrades">Mejoras <span id="upgrade-count" class="pi-pill" hidden></span></button>
          <button role="tab" id="tab-prestige" aria-controls="panel-prestige" aria-selected="false" data-tab="prestige">Reinvertir</button>
          <button role="tab" id="tab-shop" aria-controls="panel-shop" aria-selected="false" data-tab="shop">Tienda</button>
        </div>

        <div id="panel-gens" role="tabpanel" aria-labelledby="tab-gens" class="pi-tabpanel">
          <div class="pi-amounts" role="group" aria-label="Cantidad a comprar">
            <button data-amount="1" aria-pressed="true">x1</button>
            <button data-amount="10" aria-pressed="false">x10</button>
            <button data-amount="100" aria-pressed="false">x100</button>
            <button data-amount="max" aria-pressed="false">Máx</button>
          </div>
          <div id="gens" class="pi-list"></div>
        </div>

        <div id="panel-upgrades" role="tabpanel" aria-labelledby="tab-upgrades" class="pi-tabpanel" hidden>
          <div id="upgrades" class="pi-list"></div>
        </div>

        <div id="panel-prestige" role="tabpanel" aria-labelledby="tab-prestige" class="pi-tabpanel" hidden>
          <div class="pi-card">
            <h2>Reinvertir en licencias</h2>
            <p>
              Reinicia tu imperio a cambio de <strong>licencias</strong>. Cada licencia suma
              <strong>+5% de producción</strong> permanente, en todas tus partidas.
            </p>
            <p class="pi-row"><span>Licencias actuales</span><strong id="licenses">0</strong></p>
            <p class="pi-row"><span>Ganarías ahora</span><strong id="pending">0</strong></p>
            <p class="pi-row"><span>Bonus actual</span><strong id="license-bonus">+0%</strong></p>
            <button id="prestige" class="btn btn-primary" disabled>Reinvertir</button>
            <p id="prestige-hint" class="pi-muted"></p>
          </div>
        </div>

        <div id="panel-shop" role="tabpanel" aria-labelledby="tab-shop" class="pi-tabpanel" hidden>
          <div class="pi-card" id="boost-card">
            <h2>Boost gratis</h2>
            <p>Mira un anuncio corto y multiplica tu producción x2 durante 2 minutos (se acumula hasta 10).</p>
            <button id="watch-ad" class="btn btn-primary">▶ Ver anuncio</button>
          </div>

          <div id="products" class="pi-products"></div>

          <form id="redeem-form" class="pi-card" autocomplete="off">
            <h2>Canjear código</h2>
            <p class="pi-muted">¿Compraste algo? Pega aquí el código que recibiste.</p>
            <div class="pi-redeem">
              <label class="pi-sr" for="redeem-code">Código</label>
              <input id="redeem-code" name="code" type="text" placeholder="XXXX-XXXX-XXXX" maxlength="40" spellcheck="false" />
              <button class="btn btn-secondary" type="submit">Canjear</button>
            </div>
          </form>

          <div class="pi-card">
            <h2>Logros <span id="ach-count" class="pi-muted"></span></h2>
            <ul id="achievements" class="pi-ach"></ul>
          </div>

          <div class="pi-card pi-stats">
            <h2>Estadísticas</h2>
            <p class="pi-row"><span>Ganado en total</span><strong id="stat-lifetime">0</strong></p>
            <p class="pi-row"><span>Clicks</span><strong id="stat-clicks">0</strong></p>
            <p class="pi-row"><span>Reinversiones</span><strong id="stat-resets">0</strong></p>
            <p class="pi-row"><span>Pagos VIP recogidos</span><strong id="stat-golden">0</strong></p>
            <button id="reset" class="btn btn-outline">Borrar partida</button>
          </div>
        </div>
      </aside>
    </div>

    <div id="banner" class="pi-banner" hidden></div>

    <footer class="pi-footer">
      <span>Pagos Idle · juego gratis</span>
      <nav aria-label="Información legal">
        <a href="/privacy">Privacidad</a>
        <a href="/terms">Términos</a>
      </nav>
    </footer>
  </main>

  <div id="toast" class="pi-toast" role="status" aria-live="polite"></div>

  <dialog id="ad-dialog" class="pi-dialog" aria-labelledby="ad-title">
    <h2 id="ad-title">Anuncio simulado</h2>
    <p>Modo de prueba: así se verá la espera antes de la recompensa.</p>
    <p class="pi-count"><span data-ad-count>5</span></p>
    <button class="btn btn-outline" data-ad-close>Cerrar sin recompensa</button>
  </dialog>
</Layout>

<script>
  import '../game/main';
</script>

<style is:global>
  /* El atributo hidden debe ganar siempre (clases como .btn o .pill ponen su propio display). */
  .pi [hidden] { display: none !important; }

  .pi {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: 1rem 1rem 3rem;
  }

  .pi-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0 1rem;
  }
  .pi-top .pi-side { flex: 1; }
  .pi-top .pi-side--end { display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem; }
  .pi-icon {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--text);
    background: var(--surface2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .pi-icon:hover { border-color: var(--accent); }
  .pi-icon:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pi-icon[aria-pressed='false'] { opacity: 0.6; }
  .pi-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .pi-title {
    font-family: var(--font-mono);
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    letter-spacing: -0.01em;
  }
  .pi-title span { color: var(--accent); opacity: 0.7; margin: 0 0.25rem; }

  .pi-hud {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.5rem 2.5rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .pi-stat { display: flex; flex-direction: column; }
  .pi-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .pi-big {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 6vw, 2.75rem);
    line-height: 1.1;
    color: var(--accent-light);
    font-variant-numeric: tabular-nums;
  }
  .pi-big--sm { font-size: clamp(1.1rem, 3.5vw, 1.5rem); color: var(--text); }
  .pi-badges { margin-left: auto; display: flex; flex-wrap: wrap; gap: 0.35rem; justify-content: flex-end; }
  .pi-boost--frenzy { background: var(--accent-light); }
  .pi-boost {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }

  .pi-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .pi-layout { display: block; }
  }

  .pi-stage {
    position: sticky;
    top: 0.5rem;
  }

  #scene {
    display: block;
    width: 100%;
    height: clamp(300px, 48vh, 470px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg);
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #scene:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pi-hint {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* El efecto 3D de .glass-card (inclinar al pasar el cursor) estorba en un panel donde se hace
     click constantemente y en táctil se queda "pegado": aquí el panel es plano. */
  .pi-panel.glass-card,
  .pi-panel.glass-card:hover {
    padding: 0;
    transform: none;
    transform-style: flat;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: inset 0 1px 0 rgba(255, 230, 180, 0.12), 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  .pi-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .pi-tabs button {
    flex: 1;
    min-width: max-content;
    padding: 0.8rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }
  .pi-tabs button:hover { color: var(--text); }
  .pi-tabs button[aria-selected='true'] { color: var(--accent-light); border-bottom-color: var(--accent); }
  .pi-tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .pi-pill {
    display: inline-block;
    min-width: 1.2em;
    padding: 0 0.35em;
    margin-left: 0.25rem;
    border-radius: 99px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.7rem;
  }

  .pi-tabpanel { padding: 0.75rem; max-height: min(70vh, 640px); overflow-y: auto; }
  .pi-tabpanel[hidden] { display: none; }
  .pi-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .pi-amounts { display: flex; gap: 0.4rem; margin-bottom: 0.75rem; }
  .pi-amounts button {
    flex: 1;
    padding: 0.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .pi-amounts button[aria-pressed='true'] { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); font-weight: 700; }

  .pi-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 0.75rem;
    width: 100%;
    padding: 0.65rem 0.8rem;
    text-align: left;
    color: var(--text);
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: border-color 0.15s var(--ease-out), background 0.15s var(--ease-out);
  }
  .pi-item:disabled { cursor: not-allowed; opacity: 0.62; }
  .pi-item:not(:disabled):hover { border-color: var(--accent); background: var(--surface); }
  .pi-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pi-item.is-pop { animation: pi-pop 0.32s var(--ease-out); }
  .pi-item.is-hint:not(:disabled) { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow-strong); animation: pi-hint 1.2s ease-in-out infinite; }
  @keyframes pi-pop { 0% { transform: scale(1); } 40% { transform: scale(1.035); background: var(--surface); } 100% { transform: scale(1); } }
  @keyframes pi-hint { 0%, 100% { box-shadow: 0 0 0 2px var(--accent-glow); } 50% { box-shadow: 0 0 0 5px var(--accent-glow-strong); } }
  .pi-item-name { font-weight: 600; font-size: 0.95rem; }
  .pi-item-desc { grid-column: 1; font-size: 0.78rem; color: var(--muted); line-height: 1.4; }
  .pi-item-count {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    text-align: right;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .pi-item-count b { display: block; font-size: 1.4rem; color: var(--accent-light); line-height: 1; }
  .pi-item-count small { color: var(--muted); font-size: 0.7rem; }
  .pi-item-cost {
    grid-column: 1 / -1;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--danger);
  }
  .pi-item.is-affordable .pi-item-cost { color: var(--success); }

  .pi-card {
    padding: 0.9rem;
    margin-bottom: 0.75rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .pi-card h2 { font-family: var(--font-mono); font-size: 0.95rem; margin-bottom: 0.4rem; color: var(--accent-light); }
  .pi-card p { font-size: 0.85rem; line-height: 1.55; margin-bottom: 0.6rem; }
  .pi-card .btn { padding: 0.65rem 1.25rem; width: 100%; }
  .pi-muted { color: var(--muted); font-size: 0.78rem; }
  .pi-row { display: flex; justify-content: space-between; border-bottom: 1px dashed var(--border); padding-bottom: 0.25rem; }
  .pi-row strong { font-family: var(--font-mono); color: var(--accent-light); }
  .pi-products { display: grid; gap: 0.75rem; }
  .pi-products .pi-card { margin: 0; }
  .pi-price { font-family: var(--font-mono); font-weight: 700; color: var(--accent-light); }
  .pi-redeem { display: flex; gap: 0.5rem; }
  .pi-redeem input {
    flex: 1;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
  }
  .pi-redeem input:focus-visible { outline: 2px solid var(--accent); }
  .pi-redeem .btn { width: auto; }
  .pi-stats .btn { margin-top: 0.5rem; }
  .pi-ach { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .pi-ach li { display: flex; gap: 0.6rem; align-items: baseline; font-size: 0.82rem; opacity: 0.45; }
  .pi-ach li.is-done { opacity: 1; }
  .pi-ach li strong { color: var(--accent-light); font-family: var(--font-mono); font-size: 0.8rem; }
  .pi-ach li span { color: var(--muted); }
  .pi-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .pi-banner { margin-top: 1rem; min-height: 90px; text-align: center; }

  .pi-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .pi-footer nav { display: flex; gap: 1.25rem; }
  .pi-footer a { color: var(--muted); }
  .pi-footer a:hover { color: var(--accent-light); }

  .pi-toast {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    transform: translate(-50%, 1rem);
    z-index: 20;
    max-width: min(92vw, 420px);
    padding: 0.7rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-ink);
    background: var(--accent-light);
    border-radius: var(--radius);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .pi-toast.is-on { opacity: 1; transform: translate(-50%, 0); }

  .pi-dialog {
    margin: auto;
    padding: 1.5rem;
    max-width: min(92vw, 380px);
    text-align: center;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
  }
  .pi-dialog::backdrop { background: rgba(0, 0, 0, 0.75); }
  .pi-dialog h2 { font-family: var(--font-mono); margin-bottom: 0.5rem; }
  .pi-dialog p { font-size: 0.85rem; color: var(--muted); }
  .pi-count { font-family: var(--font-mono); font-size: 3rem; color: var(--accent-light) !important; margin: 0.75rem 0; }

  /* Celular: saldo y moneda se quedan fijos arriba mientras te desplazas por el menú,
     así puedes comprar y seguir tocando sin ir y venir. */
  @media (max-width: 860px) {
    .pi { padding: 0 0.75rem 2rem; }
    .pi-top { padding: 0.5rem 0; }
    .pi-hud {
      position: sticky;
      top: 0;
      z-index: 8;
      margin: 0 -0.75rem 0;
      padding: 0.4rem 0.85rem;
      gap: 0.1rem 1.1rem;
      border-radius: 0;
      border-width: 0 0 1px;
    }
    .pi-big { font-size: 1.6rem; }
    .pi-big--sm { font-size: 1.05rem; }
    .pi-stage {
      top: var(--hud-h, 64px);
      z-index: 7;
      margin: 0 -0.75rem;
      padding: 0 0.75rem 0.35rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    #scene { height: clamp(165px, 23vh, 215px); }
    .pi-hint { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0.3rem; }
    .pi-panel { margin-top: 0.5rem; }
  }
  @media (max-width: 480px) {
    .pi-tabs button { flex: 1 1 0; min-width: 0; padding: 0.75rem 0.15rem; font-size: 0.72rem; }
    .pi-pill { margin-left: 0.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-toast, .pi-item { transition: none; }
    .pi-item.is-pop, .pi-item.is-hint:not(:disabled) { animation: none; }
  }
</style>
