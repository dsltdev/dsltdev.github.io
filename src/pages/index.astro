---
import Layout from '../layouts/Layout.astro';
import { OFERTA, cop, mailto } from '../data/oferta';
import { revisiones, pasos, proyectos, preguntas, hallazgo } from '../data/contenido';
import Asistente from '../components/Asistente.astro';

const precioAuditoria = cop(OFERTA.auditoria.precio);
const precioMonitoreo = cop(OFERTA.monitoreo.precio);
const anio = new Date().getFullYear();
// El asistente solo aparece si hay un Worker desplegado (PUBLIC_ASISTENTE_URL, o OFERTA.asistenteUrl).
const asistenteUrl = import.meta.env.PUBLIC_ASISTENTE_URL || OFERTA.asistenteUrl;

// Datos estructurados para buscadores: solo lo que ya es público en la página.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${OFERTA.nombre} — Auditoría de pagos y desarrollo fintech`,
  url: 'https://dsltdev.com/',
  image: 'https://dsltdev.com/og-servicios.png',
  email: OFERTA.email,
  areaServed: ['CO', 'Latinoamérica'],
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  founder: { '@type': 'Person', name: OFERTA.nombre, sameAs: [OFERTA.github] },
  makesOffer: {
    '@type': 'Offer',
    name: 'Auditoría de integración de pagos',
    description: `Revisión del código de tu integración de pagos con reporte de hallazgos, severidad y corrección en ${OFERTA.auditoria.entrega}.`,
    price: OFERTA.auditoria.precio,
    priceCurrency: 'COP',
    url: 'https://dsltdev.com/#servicios'
  }
};
---

<Layout
  title="Auditoría de pagos y desarrollo fintech | David López"
  description={`Auditoría de integraciones de pago en ${OFERTA.auditoria.entrega} por ${precioAuditoria} y desarrollo fintech a la medida: Wompi, Bancolombia y Cloudflare Workers.`}
  image="/og-servicios.png"
  depth={false}
>
  <header class="sv-top">
    <div class="sv-wrap sv-top-in">
      <a class="sv-brand" href="/" aria-label="David López, inicio"><span>[</span> DL <span>]</span></a>
      <nav class="sv-nav" aria-label="Secciones">
        <a href="#servicios">Servicios</a>
        <a href="#como">Cómo funciona</a>
        <a href="#trabajo">Trabajo real</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="sv-mini" href={OFERTA.pagoAuditoria} target="_blank" rel="noopener" data-track="landing_pagar" data-donde="encabezado">Pedir auditoría</a>
    </div>
  </header>

  <main>
    <section class="sv-hero">
      <div class="sv-wrap sv-hero-grid">
        <div class="sv-hero-text">
          <p class="sv-eyebrow">Integraciones de pago · {OFERTA.ciudad}</p>
          <h1>El bug que no viste todavía te va a costar plata.</h1>
          <p class="sv-lead">
            Reviso la parte de tu sistema donde se mueve el dinero. Auditoría de pagos en {OFERTA.auditoria.entrega} y
            desarrollo fintech a la medida, con dinero real en producción.
          </p>
          <div class="sv-cta">
            <a class="btn btn-primary sv-btn" href={OFERTA.pagoAuditoria} target="_blank" rel="noopener" data-track="landing_pagar" data-donde="hero">
              Pagar la auditoría · {precioAuditoria} →
            </a>
            <a class="btn btn-secondary sv-btn" href={mailto('Proyecto fintech')} data-track="landing_correo" data-donde="hero">Contarme tu proyecto</a>
          </div>
          <p class="sv-micro">Pagás con Wompi. No necesito tus llaves privadas ni acceso de escritura.</p>
          <p class="sv-stack"><span>En producción con</span> Wompi · Bancolombia · Truora · Cloudflare Workers · TypeScript · Python</p>
        </div>

        <figure class="sv-report" aria-labelledby="sv-report-cap">
          <div class="sv-report-bar"><span>reporte-auditoria.md</span><em>hallazgo real</em></div>
          <div class="sv-report-body">
            <p class="sv-sev">Severidad alta</p>
            <h2 class="sv-finding">{hallazgo.titulo}</h2>
            <p>{hallazgo.texto}</p>
            <p class="sv-fix"><b>Corrección</b> {hallazgo.correccion}</p>
          </div>
          <figcaption id="sv-report-cap">
            Corregido en producción, no es un ejemplo de marketing.
            <a href={hallazgo.articulo}>Leer el caso completo →</a>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="sv-libro" aria-labelledby="h-libro">
      <div class="sv-wrap">
        <figure class="sv-libro-fig">
          <div class="sv-libro-head">
            <h2 id="h-libro" class="sv-libro-title">Partida doble</h2>
            <button type="button" class="sv-libro-btn" id="sv-libro-btn" aria-pressed="true" aria-label="Pausar la animación">
              <span aria-hidden="true" id="sv-libro-ico">❚❚</span>
              <span id="sv-libro-txt">Pausar</span>
            </button>
          </div>
          <div class="sv-libro-lienzo">
            <canvas
              id="sv-libro-canvas"
              role="img"
              aria-label="Animación generativa: pares de hilos ámbar y azul que se trenzan como imágenes especulares y se cancelan en una línea de cierre; de vez en cuando un hilo rojo sin pareja cruza la línea y queda a la deriva."
            ></canvas>
          </div>
          <div class="sv-libro-pie">
            <ul class="sv-leyenda" aria-label="Leyenda">
              <li><i class="sv-d sv-d--deb"></i>Débito</li>
              <li><i class="sv-d sv-d--cre"></i>Crédito</li>
              <li><i class="sv-d sv-d--orf"></i>Sin pareja</li>
            </ul>
            <p class="sv-libro-cuenta" aria-hidden="true">
              <span id="sv-libro-cerr">0</span> cierres · <span id="sv-libro-orf">0</span> sin pareja
            </p>
          </div>
          <figcaption class="sv-libro-cap">
            En un libro sano todo se cancela. Lo que revisa una auditoría es lo que no cierra: el cobro duplicado, el
            webhook perdido, el reintento que nadie vio.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="sv-sec" aria-labelledby="h-revisiones">
      <div class="sv-wrap">
        <h2 id="h-revisiones" class="sv-h2">Lo que busco en tu integración</h2>
        <ul class="sv-checks">
          {revisiones.map((r) => (
            <li>
              <span class="sv-tag">{r.tema}</span>
              <p>{r.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="servicios" class="sv-sec" aria-labelledby="h-servicios">
      <div class="sv-wrap">
        <h2 id="h-servicios" class="sv-h2">Servicios</h2>
        <div class="sv-cards">
          <article class="sv-card sv-card--main">
            <p class="sv-card-label">Empezá por acá</p>
            <h3>Auditoría de integración de pagos</h3>
            <p class="sv-price">{precioAuditoria}</p>
            <p class="sv-card-meta">Entrega en {OFERTA.auditoria.entrega}</p>
            <ul>
              <li>Revisión del código de tu integración de pagos</li>
              <li>Reporte con cada hallazgo, su severidad y cómo corregirlo</li>
              <li>Sin llaves privadas ni acceso de escritura</li>
            </ul>
            <a class="btn btn-primary sv-btn" href={OFERTA.pagoAuditoria} target="_blank" rel="noopener" data-track="landing_pagar" data-donde="servicios">Pagar y empezar →</a>
          </article>

          <article class="sv-card">
            <p class="sv-card-label">Después de la auditoría</p>
            <h3>Monitoreo mensual</h3>
            <p class="sv-price">{precioMonitoreo}<span> / mes</span></p>
            <p class="sv-card-meta">Se coordina por correo</p>
            <ul>
              <li>Reviso tu integración de nuevo en cada deploy que la toca</li>
              <li>Prioridad de respuesta si aparece un bug nuevo</li>
              <li>Todavía no es un cobro automático: lo acordamos entre vos y yo</li>
            </ul>
            <a class="btn btn-secondary sv-btn" href={mailto('Monitoreo mensual')} data-track="landing_correo" data-donde="monitoreo">Preguntar por el monitoreo</a>
          </article>

          <article class="sv-card">
            <p class="sv-card-label">Para construir</p>
            <h3>Desarrollo fintech a la medida</h3>
            <p class="sv-price sv-price--txt">Cotización según alcance</p>
            <p class="sv-card-meta">Contame qué necesitás</p>
            <ul>
              <li>Integraciones de pago, wallets y servicios en Cloudflare Workers</li>
              <li>TypeScript y Python, con Wompi, Bancolombia y Truora en producción</li>
              <li>Lo verifico en vivo antes de darlo por terminado</li>
            </ul>
            <a class="btn btn-secondary sv-btn" href={mailto('Proyecto fintech', 'Hola David, quiero cotizar este proyecto:\n\n- Qué necesito:\n- Para cuándo:\n')} data-track="landing_correo" data-donde="desarrollo">Contarme tu proyecto</a>
          </article>
        </div>
      </div>
    </section>

    <section id="como" class="sv-sec" aria-labelledby="h-como">
      <div class="sv-wrap">
        <h2 id="h-como" class="sv-h2">Cómo funciona la auditoría</h2>
        <ol class="sv-steps">
          {pasos.map((p) => (
            <li>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="trabajo" class="sv-sec" aria-labelledby="h-trabajo">
      <div class="sv-wrap">
        <h2 id="h-trabajo" class="sv-h2">Trabajo real, en producción</h2>
        <ul class="sv-projects">
          {proyectos.map((p) => (
            <li>
              <h3>{p.nombre}</h3>
              <p>{p.texto}</p>
              <p class="sv-tags">{p.tags.join(' · ')}</p>
              <a href={p.enlace.url} target="_blank" rel="noopener">{p.enlace.texto} ↗</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sv-sec" aria-labelledby="h-quien">
      <div class="sv-wrap sv-about">
        <div>
          <h2 id="h-quien" class="sv-h2">Quién soy</h2>
          <p>
            Soy {OFERTA.nombre}, de {OFERTA.ciudad}. Construyo y arreglo sistemas donde el dinero tiene que moverse
            bien: wallets, pasarelas de pago y señales de trading. Prefiero verificar en vivo antes que confiar en un
            test en verde.
          </p>
        </div>
        <dl class="sv-facts">
          <div><dt>Especialidad</dt><dd>Fintech, pagos y Cloudflare Workers</dd></div>
          <div><dt>Disponibilidad</dt><dd>Abierto a proyectos</dd></div>
          <div><dt>Contacto</dt><dd><a href={`mailto:${OFERTA.email}`}>{OFERTA.email}</a></dd></div>
          <div><dt>Código</dt><dd><a href={OFERTA.github} target="_blank" rel="noopener">github.com/dsltdev ↗</a></dd></div>
        </dl>
      </div>
    </section>

    <section id="preguntas" class="sv-sec" aria-labelledby="h-preguntas">
      <div class="sv-wrap">
        <h2 id="h-preguntas" class="sv-h2">Preguntas frecuentes</h2>
        <div class="sv-faq">
          {preguntas.map((q) => (
            <details>
              <summary>{q.p}</summary>
              <p>{q.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="sv-final" aria-labelledby="h-final">
      <div class="sv-wrap sv-final-in">
        <h2 id="h-final">¿Tenés pagos en producción que nadie ha revisado?</h2>
        <p>Un segundo par de ojos en el código donde se mueve la plata, en {OFERTA.auditoria.entrega}.</p>
        <div class="sv-cta">
          <a class="btn btn-primary sv-btn" href={OFERTA.pagoAuditoria} target="_blank" rel="noopener" data-track="landing_pagar" data-donde="final">Pagar la auditoría · {precioAuditoria} →</a>
          <a class="btn btn-secondary sv-btn" href={mailto('Duda antes de pagar')} data-track="landing_correo" data-donde="final">Escribime antes</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="sv-foot">
    <div class="sv-wrap sv-foot-in">
      <p>© {anio} {OFERTA.nombre} · {OFERTA.ciudad}</p>
      <nav aria-label="Enlaces del sitio">
        <a href="/blog">Blog</a>
        <a href={OFERTA.github} target="_blank" rel="noopener">GitHub</a>
        <a href="/privacy">Privacidad</a>
        <a href="/terms">Términos</a>
        <a href="/juego">Juego</a>
      </nav>
    </div>
  </footer>

  <Asistente url={asistenteUrl} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
</Layout>

<script>
  import { montarLibro } from '../landing/libro';

  // Mide qué botón se toca (Plausible no usa cookies). Si la analítica no cargó, no pasa nada.
  type Plausible = (evento: string, opciones?: { props?: Record<string, string> }) => void;
  document.addEventListener('click', (e) => {
    const el = (e.target as Element | null)?.closest<HTMLElement>('[data-track]');
    if (!el?.dataset.track) return;
    try {
      (window as unknown as { plausible?: Plausible }).plausible?.(el.dataset.track, { props: { donde: el.dataset.donde ?? '' } });
    } catch {
      /* sin analítica el botón funciona igual */
    }
  });

  // Banda "Partida doble": arte generativo (ver docs/partida-doble.md). Respeta "reducir movimiento".
  const lienzo = document.getElementById('sv-libro-canvas') as HTMLCanvasElement | null;
  const btn = document.getElementById('sv-libro-btn') as HTMLButtonElement | null;
  if (lienzo && btn) {
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ico = document.getElementById('sv-libro-ico');
    const txt = document.getElementById('sv-libro-txt');
    const cerr = document.getElementById('sv-libro-cerr');
    const orf = document.getElementById('sv-libro-orf');
    const pintarBoton = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? 'Pausar la animación' : 'Reanudar la animación');
      if (ico) ico.textContent = on ? '❚❚' : '▶';
      if (txt) txt.textContent = on ? 'Pausar' : 'Animar';
    };
    pintarBoton(!quieto);
    const libro = montarLibro(lienzo, {
      reducedMotion: quieto,
      onStats: (c, s) => {
        if (cerr) cerr.textContent = String(c);
        if (orf) orf.textContent = String(s);
      },
      onPlayingChange: pintarBoton
    });
    let activo = !quieto;
    btn.addEventListener('click', () => {
      activo = !activo;
      libro.setPlaying(activo);
    });
  }
</script>

<style>
  .sv-wrap {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 1.25rem;
  }

  /* Encabezado */
  .sv-top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .sv-top-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .sv-brand {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .sv-brand span {
    color: var(--accent);
  }
  .sv-nav {
    display: none;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .sv-nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .sv-nav a:hover {
    color: var(--accent-light);
  }
  .sv-mini {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .sv-mini:hover {
    background: var(--accent-light);
  }
  @media (min-width: 820px) {
    .sv-nav {
      display: flex;
    }
  }

  /* Banda de arte generativo: "Partida doble" */
  .sv-libro {
    padding-block: 0 clamp(2rem, 5vw, 3.5rem);
  }
  .sv-libro-fig {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    overflow: hidden;
  }
  .sv-libro-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.9rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .sv-libro-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sv-libro-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    padding: 0.25rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .sv-libro-btn:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }
  .sv-libro-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sv-libro-lienzo {
    width: 100%;
    line-height: 0;
  }
  .sv-libro-lienzo canvas {
    display: block;
    width: 100%;
    min-height: 210px;
  }
  .sv-libro-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1.25rem;
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .sv-leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sv-leyenda li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .sv-d {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }
  .sv-d--deb {
    background: #e0a23e;
  }
  .sv-d--cre {
    background: #6fb3c7;
  }
  .sv-d--orf {
    background: #ef6a4a;
  }
  .sv-libro-cuenta {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .sv-libro-cap {
    margin: 0;
    padding: 0.8rem 0.9rem 0.95rem;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Hero */
  .sv-hero {
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }
  .sv-hero-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  @media (min-width: 900px) {
    .sv-hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 3.5rem;
    }
  }
  .sv-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .sv-hero h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.9rem, 5.2vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: 0 0 1.1rem;
  }
  .sv-lead {
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 52ch;
    margin-bottom: 1.6rem;
  }
  .sv-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .sv-btn {
    min-height: 3rem;
    text-align: center;
  }
  .sv-micro {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.9rem 0 0;
  }
  .sv-stack {
    margin: 1.6rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.7;
  }
  .sv-stack span {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-dim);
    margin-bottom: 0.2rem;
  }

  /* Reporte de muestra */
  .sv-report {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--glass-shadow);
  }
  .sv-report-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .sv-report-bar em {
    font-style: normal;
    color: var(--success);
  }
  .sv-report-body {
    padding: 1.2rem 1.25rem 1.3rem;
    font-size: 0.93rem;
  }
  .sv-report-body p {
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .sv-report-body .sv-sev {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e8b4a4;
    background: var(--danger-glow);
    border: 1px solid var(--danger);
    padding: 0.2rem 0.55rem;
