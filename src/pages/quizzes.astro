---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Quizzes | NeuroFamilia">
  <div class="app-layout">
    <aside class="sidebar glass-card">
      <div class="sidebar-header">
        <a href="/" class="nav-logo">
          <span class="logo-icon">🧠</span>
          <span class="logo-text">NeuroFamilia</span>
        </a>
      </div>

      <nav class="sidebar-nav">
        <a href="/app" class="nav-item">
          <span class="nav-icon">📊</span>
          <span>Dashboard</span>
        </a>
        <a href="#contenido" class="nav-item">
          <span class="nav-icon">📚</span>
          <span>Contenido</span>
        </a>
        <a href="#quizzes" class="nav-item active">
          <span class="nav-icon">🧠</span>
          <span>Quizzes</span>
        </a>
        <a href="#progreso" class="nav-item">
          <span class="nav-icon">📈</span>
          <span>Progreso</span>
        </a>
        <a href="#comunidad" class="nav-item">
          <span class="nav-icon">👥</span>
          <span>Comunidad</span>
        </a>
        <a href="#coaching" class="nav-item">
          <span class="nav-icon">🎓</span>
          <span>Coaching</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="user-info">
          <div class="user-avatar">M</div>
          <div class="user-details">
            <span class="user-name">María González</span>
            <span class="user-plan">Plan Pro</span>
          </div>
        </div>
        <button class="logout-btn">Cerrar sesión</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div class="topbar-left">
          <h1>Quizzes y evaluaciones 🧠</h1>
          <p class="topbar-subtitle">Descubrí tu estilo parental y evaluá tus conocimientos</p>
        </div>
      </header>

      <div class="quiz-hero glass-card">
        <div class="quiz-hero-content">
          <span class="badge">✨ Popular</span>
          <h2>Quiz de Estilos Parentales</h2>
          <p>Descubrí tu estilo de crianza y recibí recomendaciones personalizadas basadas en evidencia científica.</p>
          <div class="quiz-meta">
            <span>⏱️ 10 minutos</span>
            <span>❓ 25 preguntas</span>
            <span>📜 Certificado</span>
          </div>
          <button class="btn btn-primary btn-lg">Empezar quiz →</button>
        </div>
        <div class="quiz-hero-visual">
          <div class="quiz-preview glass-card">
            <div class="preview-question">
              <span class="question-number">Pregunta 1 de 25</span>
              <p class="question-text">¿Cómo reaccionás cuando tu hijo tiene una rabieta en público?</p>
            </div>
            <div class="preview-options">
              <div class="option">A. Me quedo calmado y espero a que se calme</div>
              <div class="option selected">B. Le explico por qué no puede hacer eso</div>
              <div class="option">C. Le digo que se detenga inmediatamente</div>
              <div class="option">D. Lo ignoro hasta que pase</div>
            </div>
          </div>
        </div>
      </div>

      <div class="quizzes-section">
        <h2>Quizzes disponibles</h2>
        <div class="quiz-filters">
          <button class="filter-tab active">Todos</button>
          <button class="filter-tab">Completados</button>
          <button class="filter-tab">Pendientes</button>
          <button class="filter-tab">Nuevos</button>
        </div>

        <div class="quizzes-grid">
          <div class="quiz-card glass-card">
            <div class="quiz-icon">🧠</div>
            <div class="quiz-info">
              <h3>Estilos parentales</h3>
              <p>Descubrí tu enfoque de crianza</p>
              <div class="quiz-stats">
                <span>⏱️ 10 min</span>
                <span>❓ 25 preguntas</span>
              </div>
            </div>
            <div class="quiz-status completed">
              <span class="status-icon">✓</span>
              <span>Completado</span>
            </div>
          </div>

          <div class="quiz-card glass-card">
            <div class="quiz-icon">💡</div>
            <div class="quiz-info">
              <h3>Inteligencia emocional</h3>
              <p>Evaluá tu capacidad de manejar emociones</p>
              <div class="quiz-stats">
                <span>⏱️ 8 min</span>
                <span>❓ 20 preguntas</span>
              </div>
            </div>
            <div class="quiz-status in-progress">
              <span class="status-icon">⏸</span>
              <span>En progreso</span>
            </div>
          </div>

          <div class="quiz-card glass-card">
            <div class="quiz-icon">🎯</div>
            <div class="quiz-info">
              <h3>Comunicación familiar</h3>
              <p>Evaluá cómo comunicás con tu familia</p>
              <div class="quiz-stats">
                <span>⏱️ 12 min</span>
                <span>❓ 30 preguntas</span>
              </div>
            </div>
            <div class="quiz-status pending">
              <span class="status-icon">○</span>
              <span>Pendiente</span>
            </div>
          </div>

          <div class="quiz-card glass-card">
            <div class="quiz-icon">📚</div>
            <div class="quiz-info">
              <h3>Neurociencia básica</h3>
              <p>Test de conocimientos sobre el cerebro</p>
              <div class="quiz-stats">
                <span>⏱️ 15 min</span>
                <span>❓ 40 preguntas</span>
              </div>
            </div>
            <div class="quiz-status pending">
              <span class="status-icon">○</span>
              <span>Pendiente</span>
            </div>
          </div>

          <div class="quiz-card glass-card">
            <div class="quiz-icon">❤️</div>
            <div class="quiz-info">
              <h3>Vínculo afectivo</h3>
              <p>Evaluá la calidad de tu vínculo con tus hijos</p>
              <div class="quiz-stats">
                <span>⏱️ 10 min</span>
                <span>❓ 25 preguntas</span>
              </div>
            </div>
            <div class="quiz-status pending">
              <span class="status-icon">○</span>
              <span>Pendiente</span>
            </div>
          </div>

          <div class="quiz-card glass-card">
            <div class="quiz-icon">🌟</div>
            <div class="quiz-info">
              <h3>Fortalezas parentales</h3>
              <p>Descubrí tus puntos fuertes como padre/madre</p>
              <div class="quiz-stats">
                <span>⏱️ 8 min</span>
                <span>❓ 20 preguntas</span>
              </div>
            </div>
            <div class="quiz-status pending">
              <span class="status-icon">○</span>
              <span>Pendiente</span>
            </div>
          </div>
        </div>
      </div>

      <div class="results-section">
        <h2>Tus resultados recientes</h2>
        <div class="results-grid">
          <div class="result-card glass-card">
            <div class="result-header">
              <h3>Estilos parentales</h3>
              <span class="result-date">15 Mar 2026</span>
            </div>
            <div class="result-content">
              <div class="result-type">
                <span class="type-badge">Autoritario positivo</span>
              </div>
              <p class="result-description">Equilibrás límites claros con afecto y explicaciones. Seguís una crianza respetuosa pero firme.</p>
              <div class="result-bars">
                <div class="bar-item">
                  <span class="bar-label">Autoridad</span>
                  <div class="bar-track">
                    <div class="bar-fill" style="width: 75%;"></div>
                  </div>
                  <span class="bar-value">75%</span>
                </div>
                <div class="bar-item">
                  <span class="bar-label">Afecto</span>
                  <div class="bar-track">
                    <div class="bar-fill" style="width: 85%;"></div>
                  </div>
                  <span class="bar-value">85%</span>
                </div>
                <div class="bar-item">
                  <span class="bar-label">Comunicación</span>
                  <div class="bar-track">
                    <div class="bar-fill" style="width: 70%;"></div>
                  </div>
                  <span class="bar-value">70%</span>
                </div>
              </div>
              <button class="btn btn-outline btn-block">Ver resultado completo</button>
            </div>
          </div>

          <div class="result-card glass-card">
            <div class="result-header">
              <h3>Inteligencia emocional</h3>
              <span class="result-date">10 Mar 2026</span>
            </div>
            <div class="result-content">
              <div class="result-type">
                <span class="type-badge">Avanzado</span>
              </div>
              <p class="result-description">Tenés una excelente capacidad para identificar y manejar tus emociones y las de tus hijos.</p>
              <div class="result-bars">
                <div class="bar-item">
                  <span class="bar-label">Autoconocimiento</span>
                  <div class="bar-track">
                    <div class="bar-fill" style="width: 80%;"></div>
                  </div>
                  <span class="bar-value">80%</span>
                </div>
                <div class="bar-item">
                  <span class="bar-label">Empatía</span>
                  <div class="bar-track">
                    <div class="bar-fill" style="width: 90%;"></div>
                  </div>
                  <span class="bar-value">90%</span>
                </div>
                <div class="bar-item">
                  <span class="bar-label">Regulación</span>
                  <div class="bar-track">
                    <div class="bar-fill" style="width: 70%;"></div>
                  </div>
                  <span class="bar-value">70%</span>
                </div>
              </div>
              <button class="btn btn-outline btn-block">Ver resultado completo</button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .app-layout {
    display: flex;
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }

  /* Sidebar */
  .sidebar {
    width: 260px;
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    border-radius: 0;
    border-right: 1px solid var(--glass-border);
    border-left: none;
    border-top: none;
    border-bottom: none;
  }

  .sidebar-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .sidebar-nav {
    flex: 1;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .nav-item:hover {
    background: var(--glass-bg-hover);
    color: var(--text);
  }

  .nav-item.active {
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent-light);
  }

  .nav-icon {
    font-size: 1.1rem;
  }

  .sidebar-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--glass-border);
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: white;
  }

  .user-details {
    display: flex;
    flex-direction: column;
  }

  .user-name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
  }

  .user-plan {
    font-size: 0.75rem;
    color: var(--accent-light);
  }

  .logout-btn {
    width: 100%;
    padding: 0.5rem;
    background: transparent;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .logout-btn:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: var(--danger);
    color: var(--danger);
  }

  /* Main Content */
  .main-content {
    flex: 1;
    margin-left: 260px;
    padding: 1.5rem 2rem;
  }

  .topbar {
    margin-bottom: 1.5rem;
  }

  .topbar h1 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
  }

  .topbar-subtitle {
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Quiz Hero */
  .quiz-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
    margin-bottom: 2rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.15));
    border-color: rgba(99, 102, 241, 0.3);
  }

  .quiz-hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .quiz-hero-content h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
  }

  .quiz-hero-content p {
    color: var(--muted);
    line-height: 1.6;
  }

  .quiz-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .quiz-hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quiz-preview {
    width: 100%;
    max-width: 380px;
    padding: 1.5rem;
  }

  .preview-question {
    margin-bottom: 1.5rem;
  }

  .question-number {
    font-size: 0.8rem;
    color: var(--accent-light);
    margin-bottom: 0.5rem;
    display: block;
  }

  .question-text {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.5;
  }

  .preview-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .option {
    padding: 0.75rem 1rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  .option:hover {
    background: var(--glass-bg-hover);
    color: var(--text);
  }

  .option.selected {
    background: rgba(99, 102, 241, 0.2);
    border-color: var(--accent);
    color: var(--text);
  }

  /* Quizzes Section */
  .quizzes-section {
    margin-bottom: 2rem;
  }

  .quizzes-section h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .quiz-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-tab {
    padding: 0.5rem 1rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-tab:hover {
    background: var(--glass-bg-hover);
    color: var(--text);
  }

  .filter-tab.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .quizzes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .quiz-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
  }

  .quiz-icon {
    font-size: 2rem;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-bg);
    border-radius: 12px;
  }

  .quiz-info {
    flex: 1;
  }

  .quiz-info h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .quiz-info p {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .quiz-stats {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .quiz-status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .quiz-status.completed {
    background: rgba(16, 185, 129, 0.15);
    color: var(--success);
  }

  .quiz-status.in-progress {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
  }

  .quiz-status.pending {
    background: var(--glass-bg);
    color: var(--muted);
  }

  /* Results Section */
  .results-section {
    margin-bottom: 2rem;
  }

  .results-section h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .result-card {
    padding: 1.5rem;
  }

  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .result-header h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .result-date {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .result-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .type-badge {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-light);
  }

  .result-description {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .result-bars {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bar-item {
    display: grid;
    grid-template-columns: 100px 1fr 40px;
    align-items: center;
    gap: 0.75rem;
  }

  .bar-label {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .bar-track {
    height: 8px;
    background: var(--glass-bg);
    border-radius: 4px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 4px;
    transition: width 0.5s;
  }

  .bar-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    text-align: right;
  }

  .btn-block {
    width: 100%;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .sidebar {
      width: 80px;
    }

    .sidebar-header .logo-text,
    .nav-item span:not(.nav-icon),
    .user-details,
    .logout-btn {
      display: none;
    }

    .nav-item {
      justify-content: center;
      padding: 0.75rem;
    }

    .user-info {
      justify-content: center;
    }

    .main-content {
      margin-left: 80px;
    }

    .quiz-hero {
      grid-template-columns: 1fr;
    }

    .quiz-hero-visual {
      display: none;
    }

    .quizzes-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .results-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }

    .main-content {
      margin-left: 0;
      padding: 1rem;
    }

    .quizzes-grid {
      grid-template-columns: 1fr;
    }

    .quiz-card {
      flex-direction: column;
      align-items: flex-start;
      text-align: center;
    }

    .quiz-icon {
      margin: 0 auto;
    }
  }
</style>
