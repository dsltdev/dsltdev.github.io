---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Precios | NeuroFamilia">
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo">
        <span class="logo-icon">🧠</span>
        <span class="logo-text">NeuroFamilia</span>
      </a>
      <div class="nav-links">
        <a href="/#features">Características</a>
        <a href="#pricing">Precios</a>
        <a href="/#testimonials">Testimonios</a>
      </div>
      <div class="nav-actions">
        <a href="#login" class="btn btn-secondary btn-sm">Iniciar sesión</a>
        <a href="#register" class="btn btn-primary btn-sm">Empezar gratis</a>
      </div>
    </div>
  </nav>

  <main class="pricing-page">
    <section class="pricing-hero">
      <div class="container">
        <span class="badge">💎 Planes flexibles</span>
        <h1>Elegí el plan perfecto para tu familia</h1>
        <p class="hero-subtitle">
          Empezá gratis y升级 cuando estés listo. Sin sorpresas, cancelá cuando quieras.
        </p>

        <div class="billing-toggle">
          <span class="toggle-label">Mensual</span>
          <button class="toggle-btn">
            <span class="toggle-slider"></span>
          </button>
          <span class="toggle-label">Anual</span>
          <span class="toggle-badge">Ahorra 20%</span>
        </div>
      </div>
    </section>

    <section class="pricing-cards">
      <div class="container">
        <div class="pricing-grid">
          <div class="pricing-card glass-card">
            <div class="card-header">
              <h3>Básico</h3>
              <p class="card-desc">Perfecto para conocer NeuroFamilia</p>
              <div class="price">
                <span class="amount">Gratis</span>
              </div>
            </div>
            <ul class="features">
              <li><span class="check">✓</span> 5 artículos por mes</li>
              <li><span class="check">✓</span> 1 quiz por mes</li>
              <li><span class="check">✓</span> Tracker básico</li>
              <li><span class="check">✓</span> Acceso a comunidad</li>
              <li class="disabled"><span class="cross">✗</span> Contenido premium</li>
              <li class="disabled"><span class="cross">✗</span> Coaching</li>
            </ul>
            <a href="#register" class="btn btn-outline btn-block">Empezar gratis</a>
          </div>

          <div class="pricing-card glass-card popular">
            <div class="popular-badge">Más popular</div>
            <div class="card-header">
              <h3>Pro</h3>
              <p class="card-desc">Para familias comprometidas</p>
              <div class="price">
                <span class="currency">$</span>
                <span class="amount">9.99</span>
                <span class="period">/mes</span>
              </div>
              <p class="price-note">o $95.90/año (ahorrá 20%)</p>
            </div>
            <ul class="features">
              <li><span class="check">✓</span> Contenido ilimitado</li>
              <li><span class="check">✓</span> Quizzes ilimitados</li>
              <li><span class="check">✓</span> Tracker avanzado con insignias</li>
              <li><span class="check">✓</span> Comunidad premium</li>
              <li><span class="check">✓</span> Soporte prioritario</li>
              <li class="disabled"><span class="cross">✗</span> Coaching 1:1</li>
            </ul>
            <a href="#register" class="btn btn-primary btn-block">Empezar prueba gratis</a>
          </div>

          <div class="pricing-card glass-card">
            <div class="card-header">
              <h3>Familiar</h3>
              <p class="card-desc">La experiencia completa</p>
              <div class="price">
                <span class="currency">$</span>
                <span class="amount">14.99</span>
                <span class="period">/mes</span>
              </div>
              <p class="price-note">o $143.90/año (ahorrá 20%)</p>
            </div>
            <ul class="features">
              <li><span class="check">✓</span> Todo de Pro</li>
              <li><span class="check">✓</span> 2 sesiones coaching/mes</li>
              <li><span class="check">✓</span> Grupos de apoyo exclusivos</li>
              <li><span class="check">✓</span> Webinars en vivo</li>
              <li><span class="check">✓</span> Acceso anticipado a funciones</li>
              <li><span class="check">✓</span> Certificados</li>
            </ul>
            <a href="#register" class="btn btn-outline btn-block">Empezar prueba gratis</a>
          </div>
        </div>
      </div>
    </section>

    <section class="comparison-section">
      <div class="container">
        <h2>Compará planes</h2>
        <div class="comparison-table glass-card">
          <table>
            <thead>
              <tr>
                <th>Característica</th>
                <th>Básico</th>
                <th class="highlight">Pro</th>
                <th>Familiar</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Contenido educativo</td>
                <td>5/mes</td>
                <td class="highlight">Ilimitado</td>
                <td>Ilimitado</td>
              </tr>
              <tr>
                <td>Quizzes</td>
                <td>1/mes</td>
                <td class="highlight">Ilimitado</td>
                <td>Ilimitado</td>
              </tr>
              <tr>
                <td>Tracker de progreso</td>
                <td>Básico</td>
                <td class="highlight">Avanzado</td>
                <td>Avanzado</td>
              </tr>
              <tr>
                <td>Insignias y logros</td>
                <td>Limitado</td>
                <td class="highlight">Completo</td>
                <td>Completo</td>
              </tr>
              <tr>
                <td>Comunidad</td>
                <td>Básica</td>
                <td class="highlight">Premium</td>
                <td>Premium + Grupos</td>
              </tr>
              <tr>
                <td>Coaching 1:1</td>
                <td>✗</td>
                <td class="highlight">✗</td>
                <td>2 sesiones/mes</td>
              </tr>
              <tr>
                <td>Webinars en vivo</td>
                <td>✗</td>
                <td class="highlight">✗</td>
                <td>✓</td>
              </tr>
              <tr>
                <td>Certificados</td>
                <td>✗</td>
                <td class="highlight">✗</td>
                <td>✓</td>
              </tr>
              <tr>
                <td>Soporte</td>
                <td>Email</td>
                <td class="highlight">Prioritario</td>
                <td>Prioritario</td>
              </tr>
              <tr>
                <td></td>
                <td><a href="#register" class="btn btn-outline btn-sm">Empezar</a></td>
                <td class="highlight"><a href="#register" class="btn btn-primary btn-sm">Empezar</a></td>
                <td><a href="#register" class="btn btn-outline btn-sm">Empezar</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        <div class="faq-grid">
          <div class="faq-item glass-card">
            <h3>¿Puedo cambiar de plan después?</h3>
            <p>Sí, podés actualizar o reducir tu plan en cualquier momento. Los cambios se aplican inmediatamente y se ajusta el precio de forma proporcional.</p>
          </div>
          <div class="faq-item glass-card">
            <h3>¿Hay período de prueba?</h3>
            <p>Sí, todos los planes de pago incluyen 7 días de prueba gratis. Si no estás satisfecho, no te cobramos nada.</p>
          </div>
          <div class="faq-item glass-card">
            <h3>¿Qué métodos de pago aceptan?</h3>
            <p>Aceptamos tarjetas de crédito/débito (Visa, Mastercard, American Express) y PayPal. Los pagos se procesan de forma segura.</p>
          </div>
          <div class="faq-item glass-card">
            <h3>¿Puedo cancelar en cualquier momento?</h3>
            <p>Sí, no hay contratos ni permanencia mínima. Podés cancelar tu suscripción cuando quieras desde tu perfil.</p>
          </div>
          <div class="faq-item glass-card">
            <h3>¿Las sesiones de coaching se acumulan?</h3>
            <p>Las sesiones del plan Familiar se renuevan cada mes y no se acumulan. Te recomendamos agendarlas para aprovecharlas al máximo.</p>
          </div>
          <div class="faq-item glass-card">
            <h3>¿Ofrecen descuentos para familias numerosas?</h3>
            <p>Sí, contactanos a soporte@neurofamilia.com y te ofrecemos un plan especial personalizado para tu familia.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-card glass-card">
          <h2>¿Listo para transformar tu familia?</h2>
          <p>Unite a +2,500 familias que ya estáncriando con consciencia. Empezá gratis hoy.</p>
          <a href="#register" class="btn btn-primary btn-lg">
            Empezá gratis - 7 días de prueba
            <span>→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <a href="/" class="nav-logo">
            <span class="logo-icon">🧠</span>
            <span class="logo-text">NeuroFamilia</span>
          </a>
          <p>Neuroeducación para familias modernas.</p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <h4>Producto</h4>
            <a href="/#features">Características</a>
            <a href="#pricing">Precios</a>
            <a href="/#testimonials">Testimonios</a>
          </div>
          <div class="footer-col">
            <h4>Recursos</h4>
            <a href="#blog">Blog</a>
            <a href="#guides">Guías</a>
            <a href="#webinars">Webinars</a>
          </div>
          <div class="footer-col">
            <h4>Soporte</h4>
            <a href="#help">Centro de ayuda</a>
            <a href="#contact">Contacto</a>
            <a href="#community">Comunidad</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 NeuroFamilia. Todos los derechos reservados.</p>
        <div class="footer-legal">
          <a href="#privacy">Privacidad</a>
          <a href="#terms">Términos</a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Navbar */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 0;
    background: rgba(11, 12, 16, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--glass-border);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* Pricing Page */
  .pricing-page {
    padding-top: 100px;
    position: relative;
    z-index: 1;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .pricing-hero {
    text-align: center;
    padding: 60px 0;
  }

  .pricing-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text);
    margin: 1rem 0;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .billing-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .toggle-label {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .toggle-btn {
    width: 50px;
    height: 28px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    cursor: pointer;
    position: relative;
  }

  .toggle-slider {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    background: var(--accent);
    border-radius: 50%;
    transition: transform 0.3s;
  }

  .toggle-btn.active .toggle-slider {
    transform: translateX(22px);
  }

  .toggle-badge {
    padding: 0.25rem 0.5rem;
    background: rgba(16, 185, 129, 0.15);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--success);
  }

  /* Pricing Cards */
  .pricing-cards {
    padding: 40px 0;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .pricing-card {
    padding: 2rem;
    position: relative;
  }

  .pricing-card.popular {
    border-color: var(--accent);
    transform: scale(1.05);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: white;
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 999px;
  }

  .card-header {
    text-align: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .card-header h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem;
  }

  .currency {
    font-size: 1.25rem;
    color: var(--muted);
  }

  .amount {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--text);
  }

  .period {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .price-note {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .features {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .features li.disabled {
    opacity: 0.5;
  }

  .check {
    color: var(--success);
    font-weight: 600;
  }

  .cross {
    color: var(--muted);
  }

  .btn-block {
    width: 100%;
  }

  /* Comparison Table */
  .comparison-section {
    padding: 60px 0;
  }

  .comparison-section h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
    text-align: center;
    margin-bottom: 2rem;
  }

  .comparison-table {
    padding: 1.5rem;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    padding: 1rem;
    text-align: center;
    border-bottom: 1px solid var(--glass-border);
  }

  th {
    font-weight: 600;
    color: var(--text);
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  th.highlight,
  td.highlight {
    background: rgba(99, 102, 241, 0.1);
  }

  td {
    color: var(--muted);
  }

  /* FAQ */
  .faq-section {
    padding: 60px 0;
  }

  .faq-section h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
    text-align: center;
    margin-bottom: 2rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .faq-item {
    padding: 1.5rem;
  }

  .faq-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .faq-item p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
  }

  /* CTA */
  .cta-section {
    padding: 60px 0;
  }

  .cta-card {
    padding: 4rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
    border-color: rgba(99, 102, 241, 0.3);
  }

  .cta-card h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .cta-card p {
    font-size: 1.1rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  /* Footer */
  .footer {
    padding: 60px 0 30px;
    border-top: 1px solid var(--glass-border);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 4rem;
    margin-bottom: 3rem;
  }

  .footer-brand p {
    color: var(--muted);
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-col h4 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .footer-col a {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
    padding: 0.375rem 0;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border);
  }

  .footer-bottom p {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal a {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer-legal a:hover {
    color: var(--text);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .nav-links {
      display: none;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto;
    }

    .pricing-card.popular {
      transform: none;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .pricing-hero h1 {
      font-size: 2rem;
    }

    .cta-card {
      padding: 2rem;
    }

    .footer-links {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
