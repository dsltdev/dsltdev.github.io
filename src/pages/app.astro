---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DSLT Content Generator" description="Generador de contenido para negocios en Colombia. Posts de Instagram, WhatsApp y guiones de historia con IA.">
  <div id="app">
    <!-- ═══════════════════ AUTH VIEW ═══════════════════ -->
    <div id="auth-view" class="view active">
      <div class="auth-bg">
        <div class="auth-orb auth-orb-1"></div>
        <div class="auth-orb auth-orb-2"></div>
        <div class="auth-orb auth-orb-3"></div>
        <div class="auth-grid"></div>
      </div>
      <div class="auth-container">
        <a href="/" class="auth-logo">
          <span class="logo-bracket">{'{'}</span>
          <span class="logo-text">DSLT</span>
          <span class="logo-bracket">{'}'}</span>
        </a>
        <div class="auth-card glass-card">
          <div class="auth-header">
            <h1 id="auth-title">Creá tu cuenta</h1>
            <p id="auth-sub">300 créditos gratis. Sin tarjeta.</p>
          </div>
          <div id="auth-error" class="auth-error"></div>
          <div class="auth-oauth">
            <button class="oauth-btn" onclick="oauthLogin('google')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
              Continuar con Google
            </button>
            <button class="oauth-btn" onclick="oauthLogin('github')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              Continuar con GitHub
            </button>
          </div>
          <div class="auth-divider"><span>o usuario y contraseña</span></div>
          <form id="auth-form" onsubmit="submitAuth(event)">
            <div class="form-field">
              <input type="text" id="auth-user" placeholder="usuario" autocomplete="username" required>
            </div>
            <div class="form-field">
              <input type="password" id="auth-pass" placeholder="contraseña" autocomplete="current-password" required>
            </div>
            <div class="form-field" id="auth-pass2-field" style="display:none">
              <input type="password" id="auth-pass2" placeholder="confirmar contraseña" autocomplete="new-password">
            </div>
            <button type="submit" class="btn btn-primary auth-submit" id="auth-submit-btn">
              <span class="btn-text">Crear cuenta gratis</span>
              <span class="btn-loader" style="display:none"></span>
            </button>
          </form>
          <p class="auth-bonus">300 créditos de bienvenida</p>
          <p class="auth-toggle">
            <a href="#" onclick="toggleAuthMode();return false;" id="auth-toggle-link">¿Ya tenés cuenta? Iniciá sesión</a>
          </p>
        </div>
        <p class="auth-footer-text">DSLT · Medellín. Revisá el texto antes de publicar.</p>
      </div>
    </div>

    <!-- ═══════════════════ CHAT VIEW ═══════════════════ -->
    <div id="chat-view" class="view">
      <aside id="sidebar" class="sidebar">
        <div class="sidebar-header">
          <a href="/" class="sidebar-logo">
            <span class="logo-bracket">{'{'}</span>
            <span class="logo-text">DSLT</span>
            <span class="logo-bracket">{'}'}</span>
          </a>
          <button class="sidebar-close" onclick="toggleSidebar()" aria-label="Cerrar menú">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <button class="new-chat-btn" onclick="newConversation()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          Nueva generación
        </button>
        <div id="conv-list" class="conv-list"></div>
        <div class="sidebar-footer">
          <div class="credits-display">
            <span class="credits-label">Créditos</span>
            <span class="credits-value" id="credits-value">—</span>
          </div>
          <button class="recharge-btn" onclick="openRecharge()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 7l-5-5-5 5"/></svg>
            Recargar
          </button>
          <div class="user-row">
            <div class="user-avatar" id="user-avatar">U</div>
            <span class="user-name" id="user-name">Usuario</span>
          </div>
          <button class="logout-btn" onclick="logout()">Cerrar sesión</button>
        </div>
      </aside>

      <main id="main-chat" class="main-chat">
        <header class="topbar">
          <button class="hamburger" onclick="toggleSidebar()" aria-label="Abrir menú">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
          </button>
          <div class="topbar-center">
            <select id="model-select" class="model-select" onchange="onModelChange()"></select>
            <span id="tier-badge" class="tier-badge"></span>
          </div>
          <div class="topbar-right">
            <span class="credits-pill" id="credits-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M8 10l4-4 4 4"/></svg>
              <span id="credits-pill-value">—</span>
            </span>
          </div>
        </header>

        <div id="messages" class="messages">
          <div class="empty-state" id="empty-state">
            <div class="empty-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3>¿Qué vendés?</h3>
            <p>Escribí qué negocio tenés y te generamos contenido para Instagram, WhatsApp y historias — listo para copiar.</p>
            <div class="empty-examples">
              <button class="example-chip" onclick="useExample(this)">Vendo arepas rellenas en Laureles</button>
              <button class="example-chip" onclick="useExample(this)">Tengo una clínica odontológica en El Poblado</button>
              <button class="example-chip" onclick="useExample(this)">Una tienda de ropa deportiva online</button>
            </div>
          </div>
        </div>

        <div class="composer">
          <div class="composer-inner">
            <textarea id="composer-input" rows="1" placeholder="Ej: Vendo arepas rellenas en Laureles, Medellín, hago domicilio los fines de semana..." oninput="autoResize(this)"></textarea>
            <button id="send-btn" class="send-btn" onclick="sendMessage()" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            </button>
          </div>
          <p class="composer-hint">Se descuenta del saldo. Revisá el texto antes de publicar.</p>
        </div>
      </main>
    </div>

    <!-- ═══════════════════ RECHARGE MODAL ═══════════════════ -->
    <div id="recharge-modal" class="modal-overlay">
      <div class="modal glass-card">
        <div class="modal-header">
          <h3>Recargar créditos</h3>
          <button class="modal-close" onclick="closeRecharge()" aria-label="Cerrar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div id="pkg-list" class="pkg-list"></div>
        <div class="form-field" style="margin-top:1rem">
          <input type="email" id="recharge-email" placeholder="tu@email.com">
        </div>
        <div class="modal-actions">
          <button class="btn btn-secondary" onclick="closeRecharge()">Cancelar</button>
          <button class="btn btn-primary" onclick="submitRecharge()" id="recharge-confirm-btn">Ir a pagar</button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════ TOAST CONTAINER ═══════════════════ -->
    <div id="toast-container" class="toast-container"></div>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>

<script>
const API = location.origin;
const TOKEN_KEY = 'dslt_token';
const PROFILE_KEY = 'dslt_profile';

const state = {
  token: localStorage.getItem(TOKEN_KEY),
  user: null,
  credits: 0,
  conversations: [],
  currentConvId: null,
  messages: [],
  models: [],
  selectedModel: '',
  streaming: false,
  isRegister: false,
  selectedPkg: null,
};

// ─── UTILITIES ───
function $(id) { return document.getElementById(id); }
function show(id) { $(id).classList.add('active'); }
function hide(id) { $(id).classList.remove('active'); }

function toast(msg, type = 'info') {
  const container = $('toast-container');
  const el = document.createElement('div');
  el.className = `toast toast-${type}`;
  el.textContent = msg;
  container.appendChild(el);
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 400); }, 3500);
}

async function api(path, opts = {}) {
  const headers = { 'Content-Type': 'application/json', ...opts.headers };
  if (state.token) headers['Authorization'] = `Bearer ${state.token}`;
  const res = await fetch(`${API}${path}`, { ...opts, headers });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || data.message || `Error ${res.status}`);
  return data;
}

function renderMd(text) {
  const raw = marked.parse(text || '');
  return DOMPurify.sanitize(raw);
}

// ─── AUTH ───
function toggleAuthMode() {
  state.isRegister = !state.isRegister;
  $('auth-title').textContent = state.isRegister ? 'Creá tu cuenta' : 'Iniciá sesión';
  $('auth-sub').textContent = state.isRegister ? '300 créditos gratis. Sin tarjeta.' : 'Bienvenido de nuevo';
  $('auth-submit-btn').querySelector('.btn-text').textContent = state.isRegister ? 'Crear cuenta gratis' : 'Iniciar sesión';
  $('auth-toggle-link').textContent = state.isRegister ? '¿Ya tenés cuenta? Iniciá sesión' : '¿No tenés cuenta? Creala gratis';
  $('auth-pass2-field').style.display = state.isRegister ? 'block' : 'none';
  $('auth-error').style.display = 'none';
}

async function submitAuth(e) {
  e.preventDefault();
  const user = $('auth-user').value.trim();
  const pass = $('auth-pass').value;
  const pass2 = $('auth-pass2')?.value;
  const errEl = $('auth-error');
  const btn = $('auth-submit-btn');

  errEl.style.display = 'none';
  if (!user || !pass) { errEl.textContent = 'Completá todos los campos'; errEl.style.display = 'block'; return; }
  if (state.isRegister && pass !== pass2) { errEl.textContent = 'Las contraseñas no coinciden'; errEl.style.display = 'block'; return; }

  btn.disabled = true;
  btn.querySelector('.btn-text').style.display = 'none';
  btn.querySelector('.btn-loader').style.display = 'block';

  try {
    const endpoint = state.isRegister ? '/chat/register' : '/chat/login';
    const body = state.isRegister
      ? JSON.stringify({ username: user, password: pass })
      : JSON.stringify({ username: user, password: pass });
    const data = await api(endpoint, { method: 'POST', body });
    state.token = data.token || data.data?.token;
    localStorage.setItem(TOKEN_KEY, state.token);
    if (data.user || data.data?.user) {
      state.user = data.user || data.data?.user;
      localStorage.setItem(PROFILE_KEY, JSON.stringify(state.user));
    }
    enterApp();
  } catch (err) {
    errEl.textContent = err.message;
    errEl.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.querySelector('.btn-text').style.display = 'inline';
    btn.querySelector('.btn-loader').style.display = 'none';
  }
}

function oauthLogin(provider) {
  window.location.href = `${API}/chat/oauth/${provider}`;
}

function logout() {
  state.token = null;
  state.user = null;
  state.conversations = [];
  state.currentConvId = null;
  state.messages = [];
  localStorage.removeItem(TOKEN_KEY);
  localStorage.removeItem(PROFILE_KEY);
  $('chat-view').classList.remove('active');
  $('auth-view').classList.add('active');
}

// ─── ENTER APP ───
async function enterApp() {
  $('auth-view').classList.remove('active');
  $('chat-view').classList.add('active');

  const profile = JSON.parse(localStorage.getItem(PROFILE_KEY) || '{}');
  const name = profile.name || profile.username || 'Usuario';
  $('user-name').textContent = name;
  $('user-avatar').textContent = name.charAt(0).toUpperCase();

  await Promise.all([loadCredits(), loadModels(), loadConversations()]);
  resetChat();
}

// ─── CREDITS ───
async function loadCredits() {
  try {
    const data = await api('/credits/balance');
    state.credits = data.credits ?? data.data?.credits ?? 0;
    updateCreditsUI();
  } catch { state.credits = 0; updateCreditsUI(); }
}

function updateCreditsUI() {
  const v = state.credits.toLocaleString('es-CO');
  $('credits-value').textContent = v;
  $('credits-pill-value').textContent = v;
}

// ─── MODELS ───
async function loadModels() {
  try {
    const data = await api('/models');
    state.models = data.models || data.data?.models || data || [];
    if (!Array.isArray(state.models)) state.models = [];
    const sel = $('model-select');
    sel.innerHTML = state.models.map(m =>
      `<option value="${m.id}">${m.id.split('/').pop()} ${m.tier === 'barato' ? '🟢' : m.tier === 'medio' ? '🟡' : '🔴'}</option>`
    ).join('');
    if (state.models.length > 0) {
      state.selectedModel = state.models[0].id;
      updateTierBadge();
    }
  } catch { state.models = []; }
}

function onModelChange() {
  state.selectedModel = $('model-select').value;
  updateTierBadge();
}

function updateTierBadge() {
  const m = state.models.find(m => m.id === state.selectedModel);
  const badge = $('tier-badge');
  if (!m) { badge.textContent = ''; badge.className = 'tier-badge'; return; }
  badge.textContent = m.free ? 'Gratis' : m.tier;
  badge.className = `tier-badge ${m.tier || ''}`;
}

// ─── CONVERSATIONS ───
async function loadConversations() {
  try {
    const data = await api('/conversations');
    state.conversations = data.conversations || data.data?.conversations || data || [];
    if (!Array.isArray(state.conversations)) state.conversations = [];
    renderConversations();
  } catch { state.conversations = []; renderConversations(); }
}

function renderConversations() {
  const list = $('conv-list');
  if (state.conversations.length === 0) {
    list.innerHTML = '<p class="conv-empty">Sin conversaciones aún</p>';
    return;
  }
  list.innerHTML = state.conversations.map(c => {
    const active = c.id === state.currentConvId ? ' active' : '';
    const title = c.title || c.name || 'Nueva generación';
    const date = c.created_at ? new Date(c.created_at).toLocaleDateString('es-CO', { day: 'numeric', month: 'short' }) : '';
    return `<button class="conv-item${active}" onclick="selectConversation('${c.id}')">
      <span class="conv-title">${escHtml(title)}</span>
      <span class="conv-date">${date}</span>
    </button>`;
  }).join('');
}

function escHtml(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

async function selectConversation(id) {
  state.currentConvId = id;
  renderConversations();
  try {
    const data = await api(`/conversations/${id}`);
    state.messages = data.messages || data.data?.messages || data || [];
    if (!Array.isArray(state.messages)) state.messages = [];
    renderMessages();
  } catch { state.messages = []; renderMessages(); }
}

async function newConversation() {
  state.currentConvId = null;
  state.messages = [];
  renderConversations();
  resetChat();
}

// ─── MESSAGES ───
function resetChat() {
  $('messages').innerHTML = `
    <div class="empty-state" id="empty-state">
      <div class="empty-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <h3>¿Qué vendés?</h3>
      <p>Escribí qué negocio tenés y te generamos contenido para Instagram, WhatsApp y historias — listo para copiar.</p>
      <div class="empty-examples">
        <button class="example-chip" onclick="useExample(this)">Vendo arepas rellenas en Laureles</button>
        <button class="example-chip" onclick="useExample(this)">Tengo una clínica odontológica en El Poblado</button>
        <button class="example-chip" onclick="useExample(this)">Una tienda de ropa deportiva online</button>
      </div>
    </div>`;
}

function renderMessages() {
  const container = $('messages');
  if (state.messages.length === 0) { resetChat(); return; }
  container.innerHTML = state.messages.map(m => {
    const role = m.role === 'user' ? 'user' : 'assistant';
    const content = role === 'assistant' ? renderMd(m.content) : escHtml(m.content);
    return `<div class="msg ${role}">
      <div class="msg-avatar">${role === 'user' ? '👤' : '⚡'}</div>
      <div class="msg-bubble glass-card">${content}</div>
    </div>`;
  }).join('');
  scrollToBottom();
}

function appendMsg(role, content, streaming = false) {
  const container = $('messages');
  const empty = $('empty-state');
  if (empty) empty.remove();

  const div = document.createElement('div');
  div.className = `msg ${role}`;
  if (streaming) div.id = 'streaming-msg';

  const avatar = document.createElement('div');
  avatar.className = 'msg-avatar';
  avatar.textContent = role === 'user' ? '👤' : '⚡';

  const bubble = document.createElement('div');
  bubble.className = 'msg-bubble glass-card';
  if (streaming) bubble.id = 'streaming-bubble';
  bubble.innerHTML = role === 'assistant' ? renderMd(content) : escHtml(content);

  div.appendChild(avatar);
  div.appendChild(bubble);
  container.appendChild(div);
  scrollToBottom();
  return bubble;
}

function scrollToBottom() {
  const c = $('messages');
  requestAnimationFrame(() => { c.scrollTop = c.scrollHeight; });
}

function useExample(btn) {
  $('composer-input').value = btn.textContent;
  autoResize($('composer-input'));
  $('composer-input').focus();
  updateSendBtn();
}

// ─── COMPOSER ───
function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 160) + 'px';
  updateSendBtn();
}

function updateSendBtn() {
  $('send-btn').disabled = !$('composer-input').value.trim() || state.streaming;
}

document.addEventListener('DOMContentLoaded', () => {
  const input = $('composer-input');
  input.addEventListener('input', () => { autoResize(input); updateSendBtn(); });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });
});

// ─── SEND / STREAM ───
async function sendMessage() {
  const input = $('composer-input');
  const text = input.value.trim();
  if (!text || state.streaming) return;

  input.value = '';
  autoResize(input);
  updateSendBtn();

  state.messages.push({ role: 'user', content: text });
  appendMsg('user', text);

  state.streaming = true;
  updateSendBtn();

  const typingDiv = document.createElement('div');
  typingDiv.className = 'msg assistant';
  typingDiv.id = 'streaming-msg';
  typingDiv.innerHTML = `
    <div class="msg-avatar">⚡</div>
    <div class="msg-bubble glass-card" id="streaming-bubble">
      <div class="typing-indicator"><span></span><span></span><span></span></div>
    </div>`;
  $('messages').appendChild(typingDiv);
  scrollToBottom();

  try {
    const body = {
      model: state.selectedModel,
      messages: state.messages.map(m => ({ role: m.role, content: m.content })),
      stream: true,
    };
    if (state.currentConvId) body.conversation_id = state.currentConvId;

    const res = await fetch(`${API}/chat`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${state.token}`,
      },
      body: JSON.stringify(body),
    });

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || `Error ${res.status}`);
    }

    const bubble = $('streaming-bubble');
    let fullText = '';
    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n');
      buffer = lines.pop() || '';

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed.startsWith('data:')) continue;
        const data = trimmed.slice(5).trim();
        if (data === '[DONE]') continue;
        try {
          const parsed = JSON.parse(data);
          const delta = parsed.choices?.[0]?.delta?.content;
          if (delta) {
            fullText += delta;
            bubble.innerHTML = renderMd(fullText);
            scrollToBottom();
          }
        } catch {}
      }
    }

    state.messages.push({ role: 'assistant', content: fullText });

    const streamEl = $('streaming-msg');
    if (streamEl) {
      streamEl.removeAttribute('id');
      streamEl.querySelector('.msg-bubble')?.removeAttribute('id');
    }

    await loadCredits();
    if (!state.currentConvId) await loadConversations();
  } catch (err) {
    toast(err.message, 'error');
    const streamEl = $('streaming-msg');
    if (streamEl) streamEl.remove();
    if (state.messages.length > 0 && state.messages[state.messages.length - 1].role === 'user') {
      state.messages.pop();
    }
  } finally {
    state.streaming = false;
    updateSendBtn();
  }
}

// ─── RECHARGE ───
const PACKAGES = [
  { id: 'small', credits: 10000, amountCopCents: 19900, label: '10.000 créditos' },
  { id: 'medium', credits: 30000, amountCopCents: 49900, label: '30.000 créditos' },
  { id: 'large', credits: 100000, amountCopCents: 149900, label: '100.000 créditos' },
];

function openRecharge() {
  state.selectedPkg = null;
  $('pkg-list').innerHTML = PACKAGES.map(p => {
    const price = (p.amountCopCents / 100).toLocaleString('es-CO', { style: 'currency', currency: 'COP' });
    return `<button class="pkg-item" onclick="selectPkg('${p.id}', this)">
      <span class="pkg-label">${p.label}</span>
      <span class="pkg-price">${price}</span>
    </button>`;
  }).join('');
  $('recharge-modal').classList.add('open');
}

function closeRecharge() { $('recharge-modal').classList.remove('open'); }

function selectPkg(id, el) {
  state.selectedPkg = PACKAGES.find(p => p.id === id);
  document.querySelectorAll('.pkg-item').forEach(p => p.classList.remove('selected'));
  el.classList.add('selected');
}

async function submitRecharge() {
  if (!state.selectedPkg) { toast('Elegí un paquete', 'error'); return; }
  const email = $('recharge-email').value.trim();
  if (!email) { toast('Ingresá tu email', 'error'); return; }

  try {
    const data = await api('/credits/topup/checkout', {
      method: 'POST',
      body: JSON.stringify({ package_id: state.selectedPkg.id, email }),
    });
    const url = data.checkout_url || data.data?.checkout_url || data.url;
    if (url) window.location.href = url;
    else toast('Checkout iniciado', 'success');
  } catch (err) {
    toast(err.message, 'error');
  }
}

// ─── SIDEBAR ───
function toggleSidebar() {
  $('sidebar').classList.toggle('open');
}

// ─── INIT ───
document.addEventListener('DOMContentLoaded', () => {
  if (state.token) {
    enterApp().catch(() => { logout(); });
  }

  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token');
  if (token) {
    state.token = token;
    localStorage.setItem(TOKEN_KEY, token);
    window.history.replaceState({}, '', '/app');
    enterApp();
  }
});

// ─── MARKDOWN CONFIG ───
if (typeof marked !== 'undefined') {
